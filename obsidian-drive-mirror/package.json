{
  "name": "drive-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "One-way, content-verified mirror of a Drive-for-desktop vault into an Obsidian (iOS) vault via a read-only WSL bridge.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bridge": "node dist/bridge/cli.mjs",
    "release:dist": "bash scripts/release-dist.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
