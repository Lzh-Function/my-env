{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(date *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(sbatch *)",
      "Bash(srun *)",
      "Bash(squeue *)",
      "Bash(scancel *)",
      "Bash(sinfo *)",
      "Bash(sacct *)",
      "Bash(scontrol *)",
      "Bash(touch /tmp/claude_allow_main_edit)",
      "Bash(rm -f /tmp/claude_allow_main_edit)"
    ],
    "deny": [
      "Read(.git/**)",
      "Edit(.git/**)",
      "Write(.git/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.bashrc)",
      "Read(.workspace_rc)",
      "Bash(ssh *)",
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /*)",
      "Bash(git config *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(conda *)",
      "Bash(jupyter *)",
      "Bash(ipython *)",
      "Bash(pytest *)",
      "Bash(torchrun *)",
      "Bash(deepspeed *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(rm *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(ln *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/git-worktree-auto-create.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/git-branch-guard.sh",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/login-node-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/python-env-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/git-main-edit-guard.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/permission-request-notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-notify.sh"
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "theme": "dark",
  "showTurnDuration": true,
  "skipDangerousModePermissionPrompt": true
}
