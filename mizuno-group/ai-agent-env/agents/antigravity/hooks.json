{
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/block_dangerous_command.py"
        },
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/check_login_node.py"
        },
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/python_env_guard.py"
        },
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/check_pip_forbidden.py"
        },
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/check_sbatch_forbidden.py"
        },
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/git_branch_guard.py",
          "if": "Bash(git *)"
        }
      ]
    },
    {
      "matcher": "Read",
      "hooks": [
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/check_secret_read.py"
        }
      ]
    },
    {
      "matcher": "Edit|Write|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/git_main_edit_guard.py"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/git_worktree_auto_create.py"
        },
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/update_run_status.py"
        }
      ]
    },
    {
      "matcher": "Edit|Write|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/post_edit_format.py"
        }
      ]
    }
  ],
  "PermissionRequest": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/permission_request_notify.py"
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/stop_notify.py"
        },
        {
          "type": "command",
          "command": "~/.gemini/antigravity-cli/hooks/summarize_session.py"
        }
      ]
    }
  ]
}
