Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

%labels
    Author mizuno-group
    Version 0.1.0
    Description CUDA base system layer for agent capsules

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        locales \
        nodejs \
        npm \
        python3 \
        python3-venv \
        tini \
        wget
    rm -rf /var/lib/apt/lists/*

    useradd --create-home --shell /bin/bash sandbox
    mkdir -p /workspace /runs /scratch /cache /output
    chown -R sandbox:sandbox /workspace /runs /scratch /cache /output /home/sandbox

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin:$PATH
    export PYTHONUNBUFFERED=1

