copy_auth_credentials() {
    local run_dir="$1" agent="$2"
    if [ "$agent" = "claude" ]; then
        [ -f "$HOME/.claude/.credentials.json" ] && \
            cp "$HOME/.claude/.credentials.json" "$run_dir/home/.claude/.credentials.json"
        [ -f "$HOME/.claude.json" ] && \
            cp "$HOME/.claude.json" "$run_dir/home/.claude.json"
    elif [ "$agent" = "codex" ]; then
        [ -f "$HOME/.codex/auth.json" ] && \
            cp "$HOME/.codex/auth.json" "$run_dir/home/.codex/auth.json"
    elif [ "$agent" = "antigravity" ]; then
        [ -f "$HOME/.gemini/antigravity-cli/antigravity-oauth-token" ] && \
            cp "$HOME/.gemini/antigravity-cli/antigravity-oauth-token" "$run_dir/home/.gemini/antigravity-cli/antigravity-oauth-token"
        [ -f "$HOME/.gemini/antigravity-cli/installation_id" ] && \
            cp "$HOME/.gemini/antigravity-cli/installation_id" "$run_dir/home/.gemini/antigravity-cli/installation_id"
        [ -f "$run_dir/container_config/settings.json" ] && \
            cp "$run_dir/container_config/settings.json" "$run_dir/home/.gemini/antigravity-cli/settings.json"
    fi
}

generate_container_config() {
    local run_dir="$1" agent="$2" mode="$3"
    local config_dir="$run_dir/container_config"
    mkdir -p "$config_dir"
    if [ "$agent" = "claude" ]; then
        local base="$ROOT_DIR/agents/claude/settings.json"
        local overlay=""
        if [ "$mode" = "assist" ] && [ -f "$ROOT_DIR/agents/claude/settings.assist.json" ]; then
            overlay="$ROOT_DIR/agents/claude/settings.assist.json"
        elif [ "$mode" = "experiment" ] && [ -f "$ROOT_DIR/agents/claude/settings.experiment.json" ]; then
            overlay="$ROOT_DIR/agents/claude/settings.experiment.json"
        fi
        if [ -n "$overlay" ] && command -v jq >/dev/null 2>&1; then
            # Deep-merge base + overlay; concatenate permission arrays so hooks are preserved.
            jq -s '
              .[0] as $b | .[1] as $o |
              ($b + $o + {
                permissions: {
                  allow: (($b.permissions.allow // []) + ($o.permissions.allow // [])),
                  deny:  (($b.permissions.deny  // []) + ($o.permissions.deny  // [])),
                  ask:   (($b.permissions.ask   // []) + ($o.permissions.ask   // []))
                }
              }) | del(.extends)
            ' "$base" "$overlay" > "$config_dir/settings.json"
        else
            cp "$base" "$config_dir/settings.json"
        fi
    elif [ "$agent" = "antigravity" ]; then
        local base="$ROOT_DIR/agents/antigravity/settings.json"
        local overlay=""
        if [ "$mode" = "assist" ] && [ -f "$ROOT_DIR/agents/antigravity/settings.assist.json" ]; then
            overlay="$ROOT_DIR/agents/antigravity/settings.assist.json"
        elif [ "$mode" = "experiment" ] && [ -f "$ROOT_DIR/agents/antigravity/settings.experiment.json" ]; then
            overlay="$ROOT_DIR/agents/antigravity/settings.experiment.json"
        fi
        if [ -n "$overlay" ] && command -v jq >/dev/null 2>&1; then
            jq -s '.[0] * .[1]' "$base" "$overlay" > "$config_dir/settings.json"
        else
            cp "$base" "$config_dir/settings.json"
        fi
    elif [ "$agent" = "codex" ]; then
        cp "$(codex_config_source "$mode")" "$config_dir/config.toml"
    fi
}

codex_config_source() {
    local mode="${1:-}"
    if [ "$mode" = "assist" ] && [ -f "$ROOT_DIR/agents/codex/config.assist.toml" ]; then
        printf '%s\n' "$ROOT_DIR/agents/codex/config.assist.toml"
    elif [ "$mode" = "experiment" ] && [ -f "$ROOT_DIR/agents/codex/config.experiment.toml" ]; then
        printf '%s\n' "$ROOT_DIR/agents/codex/config.experiment.toml"
    else
        printf '%s\n' "$ROOT_DIR/agents/codex/config.toml"
    fi
}

link_codex_shared_assets() {
    local run_dir="$1"
    local skill skill_name
    mkdir -p "$run_dir/home/.codex/skills"
    cp "$run_dir/container_config/config.toml" "$run_dir/home/.codex/config.toml"
    for skill in "$ROOT_DIR"/common/skills/*; do
        [ -d "$skill" ] || continue
        skill_name="$(basename "$skill")"
        ln -sfn "/home/sandbox/ai-agent-config/common/skills/$skill_name" \
            "$run_dir/home/.codex/skills/$skill_name"
    done
}

home_config_mounts() {
    local agent="$1" run_dir="${2:-}" mode="${3:-}"
    case "$agent" in
        claude)
            local settings="$ROOT_DIR/agents/claude/settings.json"
            if [ -n "$run_dir" ] && [ -f "$run_dir/container_config/settings.json" ]; then
                settings="$run_dir/container_config/settings.json"
            fi
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/claude/CLAUDE.md" "/home/sandbox/.claude/CLAUDE.md"
            printf ' --bind %q:%q:ro' "$settings" "/home/sandbox/.claude/settings.json"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/common/hooks" "/home/sandbox/.claude/hooks"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/claude/skills" "/home/sandbox/.claude/skills"
            ;;
        codex)
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/codex/hooks.json" "/home/sandbox/.codex/hooks.json"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/codex/AGENTS.md" "/home/sandbox/.codex/AGENTS.md"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/codex/rules" "/home/sandbox/.codex/rules"
            ;;
        antigravity)
            local ag_settings="$ROOT_DIR/agents/antigravity/settings.json"
            if [ -n "$run_dir" ] && [ -f "$run_dir/container_config/settings.json" ]; then
                ag_settings="$run_dir/container_config/settings.json"
            fi
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/antigravity/GEMINI.md" "/home/sandbox/.gemini/GEMINI.md"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/antigravity/AGENTS.md" "/home/sandbox/.gemini/AGENTS.md"
            printf ' --bind %q:%q:ro' "$ag_settings" "/home/sandbox/.gemini/settings.json"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/antigravity/hooks.json" "/home/sandbox/.gemini/antigravity-cli/hooks.json"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/common/hooks" "/home/sandbox/.gemini/antigravity-cli/hooks"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/antigravity/skills" "/home/sandbox/.gemini/antigravity-cli/skills"
            ;;
    esac
}

write_prompt() {
    local path="$1" mode="$2" agent="$3" repo="$4" prompt="$5"
    
    local prefix=""
    if [ "$agent" = "antigravity" ] && { [ "$mode" = "experiment" ] || [ "$mode" = "campaign" ]; }; then
        prefix="/goal "
    fi

    cat > "$path" <<EOF
${prefix}You are running inside an HPC agent capsule.

Mode: $mode
Agent: $agent
Workspace: /workspace
Runs: /runs
Scratch: /scratch
Config: /home/sandbox/ai-agent-config

User goal:
$prompt

Required live outputs:
- /runs/live/status.json
- /runs/live/heartbeat.txt
- /runs/live/command_log.jsonl
- /runs/live/current_task.md

Required final outputs:
- /runs/artifacts/report.md
- /runs/artifacts/git_diff.patch
- /runs/artifacts/metrics.json

Host repo: $repo
EOF
    if [ -n "${GOAL:-}" ]; then
        printf '\nGoal file: %s\n' "$GOAL" >> "$path"
    fi
    if [ -n "${REVIEWERS:-}" ]; then
        printf '\nReviewers: %s\n' "$REVIEWERS" >> "$path"
    fi
    if [ -n "${TARGET_DIFF:-}" ]; then
        printf '\nTarget diff: %s\n' "$TARGET_DIFF" >> "$path"
    fi
    if [ -n "${TARGET_REPORT:-}" ]; then
        printf '\nTarget report: %s\n' "$TARGET_REPORT" >> "$path"
    fi
    if [ -n "${REQUESTED_AGENTS:-}" ]; then
        printf '\nRequested agents: %s\n' "$REQUESTED_AGENTS" >> "$path"
    fi
}

apptainer_command() {
    local mode="$1" agent="$2" run_dir="$3" gpus="$4" repo="${5:-$PWD}" launch="${6:-batch}"
    local nv="" image="$ROOT_DIR/runtime/apptainer/base-agent.sif"
    [ "$gpus" -gt 0 ] && nv=" --nv"
    local cmd
    cmd="$(agent_command "$agent" "$mode" "$launch")"
    printf 'apptainer exec%s --containall --cleanenv --home %q:%q --bind %q:%q --bind %q:%q --bind %q:%q --bind %q:%q --bind %q:%q:ro' \
        "$nv" \
        "$run_dir/home" "/home/sandbox" \
        "$repo" "/workspace:rw" \
        "$run_dir" "/runs:rw" \
        "$run_dir/scratch" "/scratch:rw" \
        "$run_dir/cache" "/cache:rw" \
        "$ROOT_DIR" "/home/sandbox/ai-agent-config"
    auth_mounts "$agent"
    home_config_mounts "$agent" "$run_dir" "$mode"
    printf ' %q bash -l -c %q\n' "$image" "$cmd"
}

write_plan() {
    local mode="$1" agent="$2" repo="$3" goal="$4" gpus="$5" time_limit="$6" prompt="$7" run_dir="$8" partition="${9:-}" launch="${10:-batch}"
    local cpus mem
    cpus="$(profile_cpus "$mode")"
    mem="$(profile_mem "$mode")"
    repo="$(cd "$repo" && pwd)"
    make_layout "$run_dir"
    generate_container_config "$run_dir" "$agent" "$mode"
    if [ "$agent" = "codex" ]; then
        link_codex_shared_assets "$run_dir"
    fi
    write_prompt "$run_dir/prompt.txt" "$mode" "$agent" "$repo" "$prompt"
    if [ -n "$goal" ]; then
        cp "$goal" "$run_dir/goal.yaml"
    else
        printf 'mode: %s\nagent: %s\n' "$mode" "$agent" > "$run_dir/goal.yaml"
    fi
    cat > "$run_dir/capsule.yaml" <<EOF
run_id: $(basename "$run_dir")
mode: $mode
agent: $agent
repo: $repo
goal: $goal
EOF
    apptainer_command "$mode" "$agent" "$run_dir" "$gpus" "$repo" "$launch" > "$run_dir/apptainer_exec.sh"
    sed -i '1i#!/usr/bin/env bash\nset -euo pipefail' "$run_dir/apptainer_exec.sh"
    cat > "$run_dir/submit.sbatch" <<EOF
#!/usr/bin/env bash
#SBATCH --job-name=agentrun-$mode-$agent
EOF
    slurm_partition_args "$partition" >> "$run_dir/submit.sbatch"
    cat >> "$run_dir/submit.sbatch" <<EOF
#SBATCH --time=$time_limit
#SBATCH --mem=$mem
#SBATCH --cpus-per-task=$cpus
EOF
    if [ "$gpus" -gt 0 ]; then
        printf '#SBATCH --gres=gpu:%s\n' "$gpus" >> "$run_dir/submit.sbatch"
    fi
    cat >> "$run_dir/submit.sbatch" <<EOF
#SBATCH --output=$run_dir/live/slurm.out
#SBATCH --error=$run_dir/live/slurm.err

set -euo pipefail
_cleanup_home() { rm -rf $run_dir/home; }
trap _cleanup_home EXIT
printf '%s\n' "\${SLURM_JOB_ID:-}" > $run_dir/live/slurm_job_id.txt
env | sort > $run_dir/artifacts/environment.txt
apptainer --version > $run_dir/artifacts/container.txt 2>/dev/null || true
set +e
bash $run_dir/apptainer_exec.sh 2>>"$run_dir/live/stderr.log"
rc=\$?
set -e
printf '%s\n' "\$rc" > $run_dir/live/exit_code.txt
if [ "\$rc" -eq 0 ]; then
    printf '{"status":"success","agent":"$agent","mode":"$mode","job_id":"%s"}\n' "\${SLURM_JOB_ID:-}" > $run_dir/live/status.json
else
    printf '{"status":"failed","exit_code":"%s","agent":"$agent","mode":"$mode","job_id":"%s"}\n' "\$rc" "\${SLURM_JOB_ID:-}" > $run_dir/live/status.json
fi
exit "\$rc"
EOF
    chmod +x "$run_dir/apptainer_exec.sh" "$run_dir/submit.sbatch"
}

command_agents() {
    printf 'Available agents:\n'
    for agent in antigravity claude codex; do
        local candidates found role
        candidates="$(agent_candidates "$agent")"
        role="$(agent_role "$agent")"
        found=""
        for cmd in $candidates; do
            if command -v "$cmd" >/dev/null 2>&1; then
                found="$(command -v "$cmd")"
                break
            fi
        done
        if [ -n "$found" ]; then
            printf '  %-12s %-9s available %s\n' "$agent" "$role" "$found"
        else
            printf '  %-12s %-9s missing   %s\n' "$agent" "$role" "$candidates"
        fi
    done
}

command_validate() {
    local missing=0
    for path in \
        common/AGENTS.md \
        agents/claude/CLAUDE.md \
        agents/claude/settings.json \
        agents/codex/AGENTS.md \
        agents/codex/config.toml \
        agents/codex/config.assist.toml \
        agents/codex/config.experiment.toml \
        agents/codex/hooks.json \
        common/codex/hooks.json \
        agents/antigravity/AGENTS.md \
        agents/antigravity/GEMINI.md \
        runtime/apptainer/base-system.def \
        runtime/apptainer/base-agent.def
    do
        if [ -e "$ROOT_DIR/$path" ]; then
            printf '[OK] %s\n' "$path"
        else
            printf '[FAIL] %s\n' "$path"
            missing=1
        fi
    done
    for profile in assist experiment campaign review multi-review; do
        local profile_path="$ROOT_DIR/profiles/$profile.yaml"
        if [ -e "$profile_path" ]; then
            printf '[OK] profiles/%s.yaml\n' "$profile"
            for key in "name:" "resources:" "outputs:" "policy:"; do
                if grep -q "^$key" "$profile_path"; then
                    printf '[OK] profiles/%s.yaml:%s\n' "$profile" "$key"
                else
                    printf '[FAIL] profiles/%s.yaml:%s\n' "$profile" "$key"
                    missing=1
                fi
            done
        else
            printf '[FAIL] profiles/%s.yaml\n' "$profile"
            missing=1
        fi
    done
    for hook in "$ROOT_DIR"/common/hooks/*; do
        [ -e "$hook" ] || continue
        if [ -x "$hook" ]; then
            printf '[OK] executable:%s\n' "${hook#$ROOT_DIR/}"
        else
            printf '[FAIL] executable:%s\n' "${hook#$ROOT_DIR/}"
            missing=1
        fi
    done
    if command -v jq >/dev/null 2>&1; then
        while IFS= read -r json_file; do
            if jq empty "$json_file" >/dev/null 2>&1; then
                printf '[OK] json:%s\n' "${json_file#$ROOT_DIR/}"
            else
                printf '[FAIL] json:%s\n' "${json_file#$ROOT_DIR/}"
                missing=1
            fi
        done < <(find "$ROOT_DIR/agents" "$ROOT_DIR/common/codex" -name '*.json' -type f)
    else
        printf '[FAIL] jq:not-found - JSON validation unavailable\n'
        missing=1
    fi
    while IFS= read -r toml_file; do
        if grep -Eq '^\[.+\]' "$toml_file"; then
            printf '[OK] toml-shape:%s\n' "${toml_file#$ROOT_DIR/}"
        else
            printf '[FAIL] toml-shape:%s\n' "${toml_file#$ROOT_DIR/}"
            missing=1
        fi
    done < <(find "$ROOT_DIR/agents" "$ROOT_DIR/tests" -name '*.toml' -type f)
    while IFS= read -r link; do
        if [ -e "$link" ]; then
            printf '[OK] symlink:%s\n' "${link#$ROOT_DIR/}"
        else
            printf '[FAIL] symlink:%s\n' "${link#$ROOT_DIR/}"
            missing=1
        fi
    done < <(find "$ROOT_DIR" \
        -path "$ROOT_DIR/.git" -prune -o \
        -path "$ROOT_DIR/.agent-runs" -prune -o \
        -type l -print)
    return "$missing"
}

command_doctor() {
    local agent="$DEFAULT_AGENT" all=0 gpus=0 failed=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --agent) agent="$2"; shift 2 ;;
            --all) all=1; shift ;;
            --gpus) gpus="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    for cmd in sinfo squeue srun sbatch jq; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '[OK] command:%s - %s\n' "$cmd" "$(command -v "$cmd")"
        else
            printf '[FAIL] command:%s - not found\n' "$cmd"
            failed=1
        fi
    done
    for cmd in apptainer uv; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '[OK] command:%s - %s\n' "$cmd" "$(command -v "$cmd")"
        else
            printf '[WARN] command:%s - not found on this host; may be provided on compute nodes or inside the image\n' "$cmd"
        fi
    done
    if [ "$all" -eq 1 ]; then
        command_agents
    else
        command_agents | grep -E "(^Available| $agent[[:space:]])" || true
    fi
    if [ -e "$ROOT_DIR/runtime/apptainer/base-agent.sif" ]; then
        printf '[OK] image:base-agent.sif\n'
    else
        printf '[FAIL] image:base-agent.sif - not built\n'
        failed=1
    fi
    if [ -w "$PWD" ]; then
        printf '[OK] writable:%s/.agent-runs\n' "$PWD"
    else
        printf '[FAIL] writable:%s/.agent-runs\n' "$PWD"
        failed=1
    fi
    if [ "$gpus" -gt 0 ]; then
        if command -v nvidia-smi >/dev/null 2>&1; then
            printf '[OK] gpu:nvidia-smi - %s\n' "$(command -v nvidia-smi)"
        else
            printf '[FAIL] gpu:nvidia-smi - not found\n'
            failed=1
        fi
    fi
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf '[OK] git:repo\n'
        printf '[OK] git:branch - %s\n' "$(git branch --show-current 2>/dev/null || true)"
        if git diff --quiet --ignore-submodules -- 2>/dev/null; then
            printf '[OK] git:worktree-clean\n'
        else
            printf '[WARN] git:worktree-dirty\n'
        fi
    else
        printf '[FAIL] git:repo - not inside a git worktree\n'
        failed=1
    fi
    return "$failed"
}

parse_run_args() {
    AGENT="$DEFAULT_AGENT"
    REPO="."
    GOAL=""
    GPUS=0
    TIME_LIMIT=""
    PARTITION="${AGENTRUN_SLURM_PARTITION:-}"
    SHOW_MOUNTS=0
    SUBMIT=0
    REVIEWERS=""
    TARGET_DIFF=""
    TARGET_REPORT=""
    REQUESTED_AGENTS=""
    PROMPT=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --agent) AGENT="$2"; shift 2 ;;
            --repo) REPO="$2"; shift 2 ;;
            --goal) GOAL="$2"; shift 2 ;;
            --gpus) GPUS="$2"; shift 2 ;;
            --time) TIME_LIMIT="$2"; shift 2 ;;
            --partition) PARTITION="$2"; shift 2 ;;
            --show-mounts) SHOW_MOUNTS=1; shift ;;
            --reviewers) REVIEWERS="$2"; shift 2 ;;
            --target-diff) TARGET_DIFF="$2"; shift 2 ;;
            --target-report) TARGET_REPORT="$2"; shift 2 ;;
            --agents) REQUESTED_AGENTS="$2"; shift 2 ;;
            --submit) SUBMIT=1; shift ;;
            --*) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
            *) PROMPT="${PROMPT:+$PROMPT }$1"; shift ;;
        esac
    done
    [ -n "$PROMPT" ] || { printf 'missing prompt\n' >&2; exit 2; }
}

command_dry_run() {
    local mode="$1"; shift
    parse_run_args "$@"
    local id run_dir
    [ -n "$TIME_LIMIT" ] || TIME_LIMIT="$(profile_time "$mode")"
    REPO="$(cd "$REPO" && pwd)"
    id="$(run_id "$mode" "$AGENT")"
    run_dir="$PWD/.agent-runs/$id"
    printf 'run_id: %s\nselected_profile: %s\nselected_agent: %s\nrepo: %s\nhost_run_directory: %s\n' "$id" "$mode" "$AGENT" "$REPO" "$run_dir"
    if [ "$mode" = "assist" ]; then
        if [ "$SUBMIT" -eq 1 ]; then
            printf 'launch_method: sbatch\n'
            printf 'sbatch_args:'
            slurm_partition_args "$PARTITION"
            printf ' --time=%s --mem=%s --cpus-per-task=%s' "$TIME_LIMIT" "$(profile_mem "$mode")" "$(profile_cpus "$mode")"
            [ "$GPUS" -gt 0 ] && printf ' --gres=gpu:%s' "$GPUS"
            printf '\n'
        else
            printf 'launch_method: srun --pty (interactive)\n'
            printf 'slurm_command: srun'
            srun_partition_args "$PARTITION"
            printf ' --time=%s --mem=%s --cpus-per-task=%s --pty' "$TIME_LIMIT" "$(profile_mem "$mode")" "$(profile_cpus "$mode")"
            [ "$GPUS" -gt 0 ] && printf ' --gres=gpu:%s' "$GPUS"
            printf '\n'
        fi
    else
        printf 'launch_method: sbatch\n'
        printf 'sbatch_args:'
        slurm_partition_args "$PARTITION"
        printf ' --time=%s --mem=%s --cpus-per-task=%s' "$TIME_LIMIT" "$(profile_mem "$mode")" "$(profile_cpus "$mode")"
        [ "$GPUS" -gt 0 ] && printf ' --gres=gpu:%s' "$GPUS"
        printf '\n'
    fi
    local launch="batch"
    if [ "$mode" = "assist" ] && [ "$SUBMIT" -eq 0 ]; then
        launch="interactive"
    fi
    printf 'apptainer: '
    apptainer_command "$mode" "$AGENT" "$run_dir" "$GPUS" "$REPO" "$launch"
    printf '\nbind_mounts:\n'
    printf '  %s/home:/home/sandbox\n' "$run_dir"
    printf '  %s:/workspace:rw\n' "$REPO"
    printf '  %s:/runs:rw\n' "$run_dir"
    printf '  %s/scratch:/scratch:rw\n' "$run_dir"
    printf '  %s/cache:/cache:rw\n' "$run_dir"
    printf '  %s:/home/sandbox/ai-agent-config:ro\n' "$ROOT_DIR"
    if [ "$SHOW_MOUNTS" -eq 1 ]; then
        auth_mounts "$AGENT"
        printf '\n'
        home_config_mounts "$AGENT" "$run_dir" "$mode"
        printf '\n'
    fi
    printf '\n--- capsule.yaml ---\n'
    printf 'run_id: %s\nmode: %s\nagent: %s\nrepo: %s\ngoal: %s\n' "$id" "$mode" "$AGENT" "$REPO" "$GOAL"
    printf '\n--- prompt.txt ---\n'
    local _ptmp
    _ptmp="$(mktemp)"
    write_prompt "$_ptmp" "$mode" "$AGENT" "$REPO" "$PROMPT"
    cat "$_ptmp"
    rm -f "$_ptmp"
    printf '\n--- expected artifacts ---\n'
    for path in \
        live/status.json \
        live/heartbeat.txt \
        live/stdout.log \
        live/stderr.log \
        live/command_log.jsonl \
        live/events.jsonl \
        live/current_task.md \
        artifacts/report.md \
        artifacts/git_diff.patch \
        artifacts/metrics.json \
        artifacts/proposed_next.yaml \
        reviews/summary.md
    do
        printf '%s\n' "$path"
    done
}

command_prepare() {
    local mode="$1"; shift
    parse_run_args "$@"
    local id run_dir
    [ -n "$TIME_LIMIT" ] || TIME_LIMIT="$(profile_time "$mode")"
    id="$(run_id "$mode" "$AGENT")"
    run_dir="$PWD/.agent-runs/$id"
    local launch="batch"
    if [ "$mode" = "assist" ] && [ "$SUBMIT" -eq 0 ]; then
        launch="interactive"
    fi
    write_plan "$mode" "$AGENT" "$REPO" "$GOAL" "$GPUS" "$TIME_LIMIT" "$PROMPT" "$run_dir" "$PARTITION" "$launch"
    printf 'prepared run: %s\n' "$run_dir"
    if [ "$mode" = "assist" ] && [ "$SUBMIT" -eq 0 ]; then
        copy_auth_credentials "$run_dir" "$AGENT"
        trap "rm -rf $(printf '%q' "$run_dir/home")" EXIT INT TERM
        local srun_args=("--time=$TIME_LIMIT" "--mem=$(profile_mem "$mode")" "--cpus-per-task=$(profile_cpus "$mode")" "--pty")
        [ -n "$PARTITION" ] && srun_args+=("--partition=$PARTITION")
        [ "$GPUS" -gt 0 ] && srun_args+=("--gres=gpu:$GPUS")
        printf 'launching interactive session via srun %s\n' "${srun_args[*]}"
        srun "${srun_args[@]}" "$run_dir/apptainer_exec.sh" || true
        rm -rf "$run_dir/home"
        return 0
    fi
    printf 'submit script: %s\n' "$run_dir/submit.sbatch"
    if [ "$SUBMIT" -eq 1 ]; then
        copy_auth_credentials "$run_dir" "$AGENT"
        sbatch "$run_dir/submit.sbatch"
    elif [ "$AGENT" = "claude" ] || [ "$AGENT" = "codex" ]; then
        printf 'auth credentials were not staged; rerun with --submit to copy them before sbatch\n'
    fi
}

command_smoke_test() {
    local agent="$DEFAULT_AGENT"
    local submit=0 partition="${AGENTRUN_SLURM_PARTITION:-}" time_limit="00:10:00" mem="4000M"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --agent) agent="$2"; shift 2 ;;
            --partition) partition="$2"; shift 2 ;;
            --time) time_limit="$2"; shift 2 ;;
            --mem) mem="$2"; shift 2 ;;
            --submit) submit=1; shift ;;
            *) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
        esac
    done
    local id run_dir
    id="$(run_id smoke-test "$agent")"
    run_dir="$PWD/.agent-runs/$id"
    make_layout "$run_dir"
    cat > "$run_dir/live/status.json" <<EOF
{"status":"prepared","agent":"$agent","mode":"smoke-test","note":"submit.sbatch must run on a Slurm compute node to complete this smoke test"}
EOF
    printf 'run_id: %s\nagent: %s\nmode: smoke-test\n' "$id" "$agent" > "$run_dir/capsule.yaml"
    printf 'Write {"smoke_test": true, "status": "passed"} to /runs/artifacts/metrics.json.\n' > "$run_dir/prompt.txt"
    printf 'mode: smoke-test\nagent: %s\n' "$agent" > "$run_dir/goal.yaml"
    cat > "$run_dir/submit.sbatch" <<EOF
#!/usr/bin/env bash
#SBATCH --job-name=agentrun-smoke-$agent
EOF
    slurm_partition_args "$partition" >> "$run_dir/submit.sbatch"
    cat >> "$run_dir/submit.sbatch" <<EOF
#SBATCH --time=$time_limit
#SBATCH --mem=$mem
#SBATCH --cpus-per-task=1
#SBATCH --output=$run_dir/live/slurm.out
#SBATCH --error=$run_dir/live/slurm.err

set -euo pipefail
printf '%s\n' "\${SLURM_JOB_ID:-}" > "$run_dir/live/slurm_job_id.txt"
printf '{"status":"running","agent":"%s","mode":"smoke-test","job_id":"%s"}\n' "$agent" "\${SLURM_JOB_ID:-}" > "$run_dir/live/status.json"
date -Iseconds > "$run_dir/live/heartbeat.txt"
printf 'Smoke test running on node %s\n' "\${SLURMD_NODENAME:-unknown}" > "$run_dir/live/stdout.log"
: > "$run_dir/live/stderr.log"
printf '{"event":"smoke-test","agent":"%s","status":"running","job_id":"%s"}\n' "$agent" "\${SLURM_JOB_ID:-}" > "$run_dir/live/command_log.jsonl"
printf '{"event":"slurm-job","status":"running"}\n' > "$run_dir/live/events.jsonl"
printf 'Smoke test completed on compute node.\n' > "$run_dir/live/current_task.md"
: > "$run_dir/artifacts/git_diff.patch"
printf '# Smoke Test Report\n\nPassed on Slurm job %s.\n' "\${SLURM_JOB_ID:-}" > "$run_dir/artifacts/report.md"
printf '{"smoke_test":true,"status":"passed","agent":"%s","job_id":"%s"}\n' "$agent" "\${SLURM_JOB_ID:-}" > "$run_dir/artifacts/metrics.json"
printf '{"status":"success","agent":"%s","mode":"smoke-test","job_id":"%s"}\n' "$agent" "\${SLURM_JOB_ID:-}" > "$run_dir/live/status.json"
printf '0\n' > "$run_dir/live/exit_code.txt"
EOF
    chmod +x "$run_dir/submit.sbatch"
    printf 'prepared smoke-test run: %s\n' "$run_dir"
    printf 'submit script: %s\n' "$run_dir/submit.sbatch"
    if [ "$submit" -eq 1 ]; then
        sbatch "$run_dir/submit.sbatch"
    fi
}

command_status() {
    cat "$PWD/.agent-runs/latest/live/status.json"
}

command_logs() {
    if [ "${1:-}" = "--follow" ]; then
        tail -f "$PWD/.agent-runs/latest/live/slurm.out"
    else
        cat "$PWD/.agent-runs/latest/live/slurm.out"
    fi
}

command_list_runs() {
    [ -d "$PWD/.agent-runs" ] || return 0
    find "$PWD/.agent-runs" -mindepth 1 -maxdepth 1 ! -name latest -printf '%f\n' | sort
}

command_open_run() {
    local target="${1:-$PWD/.agent-runs/latest}"
    if [ -L "$target" ]; then
        readlink -f "$target"
    else
        printf '%s\n' "$target"
    fi
}

command_verify_run() {
    local run_dir=""
    if [ "${1:-}" = "--run-id" ]; then
        run_dir="$PWD/.agent-runs/$2"
    else
        run_dir="${1:-$PWD/.agent-runs/latest}"
    fi
    [ -L "$run_dir" ] && run_dir="$(readlink -f "$run_dir")"
    local failed=0
    if [ ! -d "$run_dir" ]; then
        printf '[FAIL] run directory: %s\n' "$run_dir"
        return 1
    fi
    printf '[OK] run directory: %s\n' "$run_dir"
    for path in capsule.yaml prompt.txt goal.yaml live/status.json live/heartbeat.txt live/stdout.log live/stderr.log live/command_log.jsonl live/events.jsonl live/current_task.md artifacts/report.md artifacts/git_diff.patch artifacts/metrics.json; do
        if [ -e "$run_dir/$path" ]; then
            printf '[OK] %s\n' "$path"
        else
            printf '[FAIL] %s\n' "$path"
            failed=1
        fi
    done
    if [ -s "$run_dir/artifacts/report.md" ]; then
        printf '[OK] nonempty:artifacts/report.md\n'
    else
        printf '[FAIL] nonempty:artifacts/report.md\n'
        failed=1
    fi
    local mode
    mode="$(sed -n 's/^mode:[[:space:]]*//p' "$run_dir/capsule.yaml" 2>/dev/null | sed -n '1p')"
    if [ -n "$mode" ] && profile_required_outputs "$mode" >/dev/null 2>&1; then
        while IFS= read -r path; do
            [ -n "$path" ] || continue
            if [ -e "$run_dir/$path" ]; then
                printf '[OK] profile_required:%s\n' "$path"
            else
                printf '[FAIL] profile_required:%s\n' "$path"
                failed=1
            fi
        done < <(profile_required_outputs "$mode")
    else
        printf '[FAIL] profile_required:unknown-mode:%s\n' "${mode:-missing}"
        failed=1
    fi
    if command -v jq >/dev/null 2>&1; then
        for json_file in live/status.json artifacts/metrics.json; do
            if [ -e "$run_dir/$json_file" ] && jq empty "$run_dir/$json_file" >/dev/null 2>&1; then
                printf '[OK] json:%s\n' "$json_file"
            else
                printf '[FAIL] json:%s\n' "$json_file"
                failed=1
            fi
        done
        if [ -e "$run_dir/live/command_log.jsonl" ]; then
            if sed '/^[[:space:]]*$/d' "$run_dir/live/command_log.jsonl" | jq -c . >/dev/null 2>&1; then
                printf '[OK] jsonl:live/command_log.jsonl\n'
            else
                printf '[FAIL] jsonl:live/command_log.jsonl\n'
                failed=1
            fi
        fi
        if [ -e "$run_dir/live/events.jsonl" ]; then
            if sed '/^[[:space:]]*$/d' "$run_dir/live/events.jsonl" | jq -c . >/dev/null 2>&1; then
                printf '[OK] jsonl:live/events.jsonl\n'
            else
                printf '[FAIL] jsonl:live/events.jsonl\n'
                failed=1
            fi
        fi
        if [ -e "$run_dir/live/status.json" ]; then
            local final_status
            final_status="$(jq -r '.status // empty' "$run_dir/live/status.json" 2>/dev/null || true)"
            case "$final_status" in
                success|failed|cancelled|timeout)
                    printf '[OK] final_status:%s\n' "$final_status"
                    ;;
                *)
                    printf '[FAIL] final_status:%s\n' "${final_status:-missing}"
                    failed=1
                    ;;
            esac
        fi
    else
        printf '[FAIL] jq:not-found - JSON/JSONL verification unavailable\n'
        failed=1
    fi
    if [ -e "$run_dir/live/exit_code.txt" ]; then
        printf '[OK] exit_code\n'
    else
        printf '[FAIL] exit_code missing\n'
        failed=1
    fi
    if [ -e "$run_dir/live/slurm_job_id.txt" ]; then
        printf '[OK] slurm_job_id\n'
    else
        printf '[FAIL] slurm_job_id missing\n'
        failed=1
    fi
    return "$failed"
}

main() {
    local command="${1:-}"
    [ -n "$command" ] || { usage; exit 2; }
    shift || true
    case "$command" in
        agents) command_agents "$@" ;;
        validate) command_validate "$@" ;;
        doctor) command_doctor "$@" ;;
        dry-run)
            [ "$#" -ge 1 ] && is_profile "$1" || { usage; exit 2; }
            local mode="$1"; shift
            command_dry_run "$mode" "$@"
            ;;
        assist|experiment|campaign|review|multi-review) command_prepare "$command" "$@" ;;
        smoke-test) command_smoke_test "$@" ;;
        status) command_status "$@" ;;
        logs) command_logs "$@" ;;
        tail) command_logs --follow ;;
        list-runs) command_list_runs "$@" ;;
        open-run) command_open_run "$@" ;;
        verify-run) command_verify_run "$@" ;;
        -h|--help|help) usage ;;
        *) printf 'unknown command: %s\n' "$command" >&2; usage; exit 2 ;;
    esac
}

[[ "${BASH_SOURCE[0]}" != "${0}" ]] || main "$@"
