#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
DEFAULT_AGENT="antigravity"
PROFILES="assist experiment campaign review multi-review"

usage() {
    cat <<'USAGE'
Usage:
  agentrun agents
  agentrun sync-claude
  agentrun sync-codex
  agentrun validate
  agentrun doctor [--agent NAME|--all]
  agentrun dry-run MODE [options] PROMPT
  agentrun assist [options] PROMPT          # interactive PTY session via srun --pty
  agentrun assist --submit [options] PROMPT # batch via sbatch (non-interactive)
  agentrun experiment|campaign|review|multi-review [options] PROMPT  # batch via sbatch
  agentrun smoke-test [--agent NAME]
  agentrun status
  agentrun logs [--follow]
  agentrun tail
  agentrun list-runs
  agentrun open-run [RUN_DIR]
  agentrun verify-run [RUN_DIR|--run-id RUN_ID]

Options:
  --agent NAME        antigravity, claude, or codex
  --repo PATH        repository path, default: .
  --goal PATH        goal.yaml path
  --gpus N           GPU count, default: 0
  --time HH:MM:SS    walltime, default comes from the selected profile
  --partition NAME   Slurm partition, default: AGENTRUN_SLURM_PARTITION or cluster default
  --reviewers LIST   reviewer agents
  --target-diff PATH review target diff
  --target-report PATH review target report
  --agents LIST      multi-review agents
  --show-mounts      print mount plan in dry-run
  --submit           submit prepared run with sbatch
USAGE
}

is_profile() {
    case " $PROFILES " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

agent_candidates() {
    case "$1" in
        antigravity) printf 'agy antigravity gemini\n' ;;
        claude) printf 'claude\n' ;;
        codex) printf 'codex\n' ;;
        *) return 1 ;;
    esac
}

agent_role() {
    case "$1" in
        antigravity) printf 'primary\n' ;;
        claude|codex) printf 'secondary\n' ;;
        *) return 1 ;;
    esac
}

first_available() {
    for cmd in "$@"; do
        if command -v "$cmd" >/dev/null 2>&1; then
            command -v "$cmd"
            return 0
        fi
    done
    return 1
}

agent_command() {
    local agent="$1" mode="${2:-}" launch="${3:-batch}"
    case "$agent" in
        claude)
            if [ "$mode" = "assist" ] && [ "$launch" = "interactive" ]; then
                printf 'claude --dangerously-skip-permissions "$(cat /runs/prompt.txt)"\n'
            else
                printf 'claude --print --dangerously-skip-permissions "$(cat /runs/prompt.txt)"\n'
            fi
            ;;
        codex)
            if [ "$mode" = "assist" ] && [ "$launch" = "interactive" ]; then
                printf 'codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --cd /workspace "$(cat /runs/prompt.txt)"\n'
            else
                printf 'codex exec --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --skip-git-repo-check --cd /workspace "$(cat /runs/prompt.txt)"\n'
            fi
            ;;
        antigravity)
            if [ "$mode" = "assist" ] && [ "$launch" = "interactive" ]; then
                printf 'if command -v agy >/dev/null 2>&1; then agy --dangerously-skip-permissions -i "$(cat /runs/prompt.txt)"; elif command -v antigravity >/dev/null 2>&1; then antigravity --dangerously-skip-permissions -i "$(cat /runs/prompt.txt)"; else gemini "$(cat /runs/prompt.txt)"; fi\n'
            else
                printf 'if command -v agy >/dev/null 2>&1; then agy --print --dangerously-skip-permissions "$(cat /runs/prompt.txt)"; elif command -v antigravity >/dev/null 2>&1; then antigravity --print --dangerously-skip-permissions "$(cat /runs/prompt.txt)"; else gemini "$(cat /runs/prompt.txt)"; fi\n'
            fi
            ;;
        *) printf 'unknown agent: %s\n' "$agent" >&2; return 2 ;;
    esac
}

profile_cpus() {
    case "$1" in
        experiment|campaign) printf '8\n' ;;
        *) printf '4\n' ;;
    esac
}

profile_mem() {
    case "$1" in
        experiment|campaign) printf '64000M\n' ;;
        review) printf '16000M\n' ;;
        *) printf '32000M\n' ;;
    esac
}

profile_time() {
    case "$1" in
        experiment) printf '04:00:00\n' ;;
        campaign) printf '04:00:00\n' ;;
        multi-review) printf '02:00:00\n' ;;
        *) printf '01:00:00\n' ;;
    esac
}

profile_required_outputs() {
    case "$1" in
        assist)
            printf '%s\n' \
                live/status.json \
                live/heartbeat.txt \
                live/stdout.log \
                live/stderr.log \
                live/command_log.jsonl \
                artifacts/report.md \
                artifacts/git_diff.patch \
                artifacts/metrics.json
            ;;
        experiment)
            printf '%s\n' \
                live/status.json \
                live/heartbeat.txt \
                live/stdout.log \
                live/stderr.log \
                live/command_log.jsonl \
                live/current_task.md \
                artifacts/report.md \
                artifacts/git_diff.patch \
                artifacts/metrics.json \
                artifacts/proposed_next.yaml
            ;;
        campaign)
            printf '%s\n' \
                live/status.json \
                live/heartbeat.txt \
                artifacts/report.md \
                artifacts/metrics.json \
                artifacts/proposed_next.yaml \
                artifacts/proposed_train.sbatch
            ;;
        review)
            printf '%s\n' \
                live/status.json \
                live/stdout.log \
                reviews/review_findings.json
            ;;
        multi-review)
            printf '%s\n' \
                live/status.json \
                reviews/antigravity.md \
                reviews/claude.md \
                reviews/codex.md \
                reviews/summary.md \
                reviews/disagreements.json \
                reviews/final_recommendation.md
            ;;
        smoke-test)
            printf '%s\n' \
                live/status.json \
                live/heartbeat.txt \
                live/stdout.log \
                live/stderr.log \
                live/command_log.jsonl \
                artifacts/report.md \
                artifacts/git_diff.patch \
                artifacts/metrics.json
            ;;
        *) return 1 ;;
    esac
}

slurm_partition_args() {
    local partition="${1:-${AGENTRUN_SLURM_PARTITION:-}}"
    [ -n "$partition" ] || return 0
    printf '#SBATCH --partition=%s\n' "$partition"
}

srun_partition_args() {
    local partition="${1:-${AGENTRUN_SLURM_PARTITION:-}}"
    [ -n "$partition" ] || return 0
    printf ' --partition=%s' "$partition"
}

run_id() {
    date +"%Y%m%d_%H%M%S_$1_$2"
}

make_layout() {
    local run_dir="$1"
    mkdir -p \
        "$run_dir/live" \
        "$run_dir/artifacts" \
        "$run_dir/reviews" \
        "$run_dir/workspace" \
        "$run_dir/scratch" \
        "$run_dir/cache" \
        "$run_dir/home/.claude" \
        "$run_dir/home/.codex" \
        "$run_dir/home/.codex/skills" \
        "$run_dir/home/.agents" \
        "$run_dir/home/.gemini/antigravity-cli" \
        "$run_dir/home/.antigravity"
    : > "$run_dir/live/stdout.log"
    : > "$run_dir/live/stderr.log"
    : > "$run_dir/live/command_log.jsonl"
    : > "$run_dir/live/events.jsonl"
    : > "$run_dir/live/slurm.out"
    : > "$run_dir/live/slurm.err"
    : > "$run_dir/live/exit_code.txt"
    : > "$run_dir/live/slurm_job_id.txt"
    printf 'initialized\n' > "$run_dir/live/current_task.md"
    printf '{}\n' > "$run_dir/live/status.json"
    date -Iseconds > "$run_dir/live/heartbeat.txt"
    : > "$run_dir/artifacts/git_diff.patch"
    printf '{}\n' > "$run_dir/artifacts/metrics.json"
    : > "$run_dir/artifacts/environment.txt"
    : > "$run_dir/artifacts/container.txt"
    : > "$run_dir/artifacts/data_manifest.txt"
    : > "$run_dir/artifacts/proposed_next.yaml"
    : > "$run_dir/artifacts/proposed_train.sbatch"
    : > "$run_dir/reviews/claude.md"
    : > "$run_dir/reviews/codex.md"
    : > "$run_dir/reviews/antigravity.md"
    printf '{}\n' > "$run_dir/reviews/review_findings.json"
    : > "$run_dir/reviews/summary.md"
    printf '{}\n' > "$run_dir/reviews/disagreements.json"
    : > "$run_dir/reviews/final_recommendation.md"
    ln -sfn "$(basename "$run_dir")" "$(dirname "$run_dir")/latest"
}

