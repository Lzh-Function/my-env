    local agent="$1"
    case "$agent" in
        claude)
            # credentials are copied to run_dir/home at submit time; --home mount delivers them
            ;;
        codex)
            # credentials are copied to run_dir/home at submit time; --home mount delivers them
            ;;
        antigravity)
            # credentials are copied to run_dir/home at submit time; --home mount delivers them
            ;;
    esac
    return 0
}

copy_auth_credentials() {
    local run_dir="$1" agent="$2"
    if [ "$agent" = "claude" ]; then
        [ -f "$HOME/.claude/.credentials.json" ] && \
            cp "$HOME/.claude/.credentials.json" "$run_dir/home/.claude/.credentials.json"
        [ -f "$HOME/.claude.json" ] && \
            cp "$HOME/.claude.json" "$run_dir/home/.claude.json"
    elif [ "$agent" = "codex" ]; then
        [ -f "$HOME/.codex/auth.json" ] && \
            cp "$HOME/.codex/auth.json" "$run_dir/home/.codex/auth.json"
    elif [ "$agent" = "antigravity" ]; then
        [ -f "$HOME/.gemini/antigravity-cli/antigravity-oauth-token" ] && \
            cp "$HOME/.gemini/antigravity-cli/antigravity-oauth-token" "$run_dir/home/.gemini/antigravity-cli/antigravity-oauth-token"
        [ -f "$HOME/.gemini/antigravity-cli/installation_id" ] && \
            cp "$HOME/.gemini/antigravity-cli/installation_id" "$run_dir/home/.gemini/antigravity-cli/installation_id"
        [ -f "$run_dir/container_config/settings.json" ] && \
            cp "$run_dir/container_config/settings.json" "$run_dir/home/.gemini/antigravity-cli/settings.json"
    fi
}

generate_container_config() {
    local run_dir="$1" agent="$2" mode="$3"
    local config_dir="$run_dir/container_config"
    mkdir -p "$config_dir"
    if [ "$agent" = "claude" ]; then
        local base="$ROOT_DIR/agents/claude/settings.json"
        local overlay=""
        if [ "$mode" = "assist" ] && [ -f "$ROOT_DIR/agents/claude/settings.assist.json" ]; then
            overlay="$ROOT_DIR/agents/claude/settings.assist.json"
        elif [ "$mode" = "experiment" ] && [ -f "$ROOT_DIR/agents/claude/settings.experiment.json" ]; then
            overlay="$ROOT_DIR/agents/claude/settings.experiment.json"
        fi
        if [ -n "$overlay" ] && command -v jq >/dev/null 2>&1; then
            # Deep-merge base + overlay; concatenate permission arrays so hooks are preserved.
            jq -s '
              .[0] as $b | .[1] as $o |
              ($b + $o + {
                permissions: {
                  allow: (($b.permissions.allow // []) + ($o.permissions.allow // [])),
                  deny:  (($b.permissions.deny  // []) + ($o.permissions.deny  // [])),
                  ask:   (($b.permissions.ask   // []) + ($o.permissions.ask   // []))
                }
              }) | del(.extends)
            ' "$base" "$overlay" > "$config_dir/settings.json"
        else
            cp "$base" "$config_dir/settings.json"
        fi
    elif [ "$agent" = "antigravity" ]; then
        local base="$ROOT_DIR/agents/antigravity/settings.json"
        local overlay=""
        if [ "$mode" = "assist" ] && [ -f "$ROOT_DIR/agents/antigravity/settings.assist.json" ]; then
            overlay="$ROOT_DIR/agents/antigravity/settings.assist.json"
        elif [ "$mode" = "experiment" ] && [ -f "$ROOT_DIR/agents/antigravity/settings.experiment.json" ]; then
            overlay="$ROOT_DIR/agents/antigravity/settings.experiment.json"
        fi
        if [ -n "$overlay" ] && command -v jq >/dev/null 2>&1; then
            jq -s '.[0] * .[1]' "$base" "$overlay" > "$config_dir/settings.json"
        else
            cp "$base" "$config_dir/settings.json"
        fi
    elif [ "$agent" = "codex" ]; then
        cp "$(codex_config_source "$mode")" "$config_dir/config.toml"
    fi
}

codex_config_source() {
    local mode="${1:-}"
    if [ "$mode" = "assist" ] && [ -f "$ROOT_DIR/agents/codex/config.assist.toml" ]; then
        printf '%s\n' "$ROOT_DIR/agents/codex/config.assist.toml"
    elif [ "$mode" = "experiment" ] && [ -f "$ROOT_DIR/agents/codex/config.experiment.toml" ]; then
        printf '%s\n' "$ROOT_DIR/agents/codex/config.experiment.toml"
    else
        printf '%s\n' "$ROOT_DIR/agents/codex/config.toml"
    fi
}

link_codex_shared_assets() {
    local run_dir="$1"
    local skill skill_name
    mkdir -p "$run_dir/home/.codex/skills"
    cp "$run_dir/container_config/config.toml" "$run_dir/home/.codex/config.toml"
    for skill in "$ROOT_DIR"/common/skills/*; do
        [ -d "$skill" ] || continue
        skill_name="$(basename "$skill")"
        ln -sfn "/home/sandbox/ai-agent-config/common/skills/$skill_name" \
            "$run_dir/home/.codex/skills/$skill_name"
    done
}

home_config_mounts() {
    local agent="$1" run_dir="${2:-}" mode="${3:-}"
    case "$agent" in
        claude)
            local settings="$ROOT_DIR/agents/claude/settings.json"
            if [ -n "$run_dir" ] && [ -f "$run_dir/container_config/settings.json" ]; then
                settings="$run_dir/container_config/settings.json"
            fi
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/claude/CLAUDE.md" "/home/sandbox/.claude/CLAUDE.md"
            printf ' --bind %q:%q:ro' "$settings" "/home/sandbox/.claude/settings.json"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/common/hooks" "/home/sandbox/.claude/hooks"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/claude/skills" "/home/sandbox/.claude/skills"
            ;;
        codex)
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/codex/requirements.toml" "/etc/codex/requirements.toml"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/codex/AGENTS.md" "/home/sandbox/.codex/AGENTS.md"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/codex/rules" "/home/sandbox/.codex/rules"
            ;;
        antigravity)
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/antigravity/GEMINI.md" "/home/sandbox/.gemini/GEMINI.md"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/antigravity/AGENTS.md" "/home/sandbox/.gemini/AGENTS.md"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/antigravity/hooks.json" "/home/sandbox/.gemini/antigravity-cli/hooks.json"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/common/hooks" "/home/sandbox/.gemini/antigravity-cli/hooks"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/antigravity/skills" "/home/sandbox/.gemini/antigravity-cli/skills"
            ;;
    esac
}

write_prompt() {
    local path="$1" mode="$2" agent="$3" repo="$4" prompt="$5"
    
    local prefix=""
    if [ "$agent" = "antigravity" ] && { [ "$mode" = "experiment" ] || [ "$mode" = "campaign" ]; }; then
        prefix="/goal "
    fi

    cat > "$path" <<EOF
${prefix}You are running inside an HPC agent capsule.

Mode: $mode
Agent: $agent
Workspace: /workspace
Runs: /runs
Scratch: /scratch
Config: /home/sandbox/ai-agent-config

User goal:
$prompt

Required live outputs:
- /runs/live/status.json
- /runs/live/heartbeat.txt
- /runs/live/command_log.jsonl
- /runs/live/current_task.md

Required final outputs:
- /runs/artifacts/report.md
- /runs/artifacts/git_diff.patch
- /runs/artifacts/metrics.json

Host repo: $repo
EOF
    if [ -n "${GOAL:-}" ]; then
        printf '\nGoal file: %s\n' "$GOAL" >> "$path"
    fi
    if [ -n "${REVIEWERS:-}" ]; then
        printf '\nReviewers: %s\n' "$REVIEWERS" >> "$path"
    fi
    if [ -n "${TARGET_DIFF:-}" ]; then
        printf '\nTarget diff: %s\n' "$TARGET_DIFF" >> "$path"
    fi
    if [ -n "${TARGET_REPORT:-}" ]; then
        printf '\nTarget report: %s\n' "$TARGET_REPORT" >> "$path"
    fi
    if [ -n "${REQUESTED_AGENTS:-}" ]; then
        printf '\nRequested agents: %s\n' "$REQUESTED_AGENTS" >> "$path"
    fi
}

apptainer_command() {
    local mode="$1" agent="$2" run_dir="$3" gpus="$4" repo="${5:-$PWD}" launch="${6:-batch}"
    local nv="" image="$ROOT_DIR/runtime/apptainer/base-agent.sif"
    [ "$gpus" -gt 0 ] && nv=" --nv"
    local cmd
    cmd="$(agent_command "$agent" "$mode" "$launch")"
    printf 'apptainer exec%s --containall --cleanenv --home %q:%q --bind %q:%q --bind %q:%q --bind %q:%q --bind %q:%q --bind %q:%q:ro' \
        "$nv" \
        "$run_dir/home" "/home/sandbox" \
        "$repo" "/workspace:rw" \
        "$run_dir" "/runs:rw" \
        "$run_dir/scratch" "/scratch:rw" \
        "$run_dir/cache" "/cache:rw" \
        "$ROOT_DIR" "/home/sandbox/ai-agent-config"
    auth_mounts "$agent"
    home_config_mounts "$agent" "$run_dir" "$mode"
    printf ' %q bash -l -c %q\n' "$image" "$cmd"
}

write_plan() {
    local mode="$1" agent="$2" repo="$3" goal="$4" gpus="$5" time_limit="$6" prompt="$7" run_dir="$8" partition="${9:-}" launch="${10:-batch}"
    local cpus mem
    cpus="$(profile_cpus "$mode")"
    mem="$(profile_mem "$mode")"
    repo="$(cd "$repo" && pwd)"
    make_layout "$run_dir"
    generate_container_config "$run_dir" "$agent" "$mode"
    if [ "$agent" = "codex" ]; then
        link_codex_shared_assets "$run_dir"
    fi
    write_prompt "$run_dir/prompt.txt" "$mode" "$agent" "$repo" "$prompt"
    if [ -n "$goal" ]; then
        cp "$goal" "$run_dir/goal.yaml"
    else
        printf 'mode: %s\nagent: %s\n' "$mode" "$agent" > "$run_dir/goal.yaml"
    fi
    cat > "$run_dir/capsule.yaml" <<EOF
run_id: $(basename "$run_dir")
mode: $mode
agent: $agent
repo: $repo
goal: $goal
EOF
    apptainer_command "$mode" "$agent" "$run_dir" "$gpus" "$repo" "$launch" > "$run_dir/apptainer_exec.sh"
    sed -i '1i#!/usr/bin/env bash\nset -euo pipefail' "$run_dir/apptainer_exec.sh"
    cat > "$run_dir/submit.sbatch" <<EOF
#!/usr/bin/env bash
#SBATCH --job-name=agentrun-$mode-$agent
EOF
    slurm_partition_args "$partition" >> "$run_dir/submit.sbatch"
    cat >> "$run_dir/submit.sbatch" <<EOF
#SBATCH --time=$time_limit
#SBATCH --mem=$mem
#SBATCH --cpus-per-task=$cpus
EOF
    if [ "$gpus" -gt 0 ]; then
        printf '#SBATCH --gres=gpu:%s\n' "$gpus" >> "$run_dir/submit.sbatch"
    fi
    cat >> "$run_dir/submit.sbatch" <<EOF
#SBATCH --output=$run_dir/live/slurm.out
#SBATCH --error=$run_dir/live/slurm.err

set -euo pipefail
_cleanup_home() { rm -rf $run_dir/home; }
trap _cleanup_home EXIT
printf '%s\n' "\${SLURM_JOB_ID:-}" > $run_dir/live/slurm_job_id.txt
env | sort > $run_dir/artifacts/environment.txt
apptainer --version > $run_dir/artifacts/container.txt 2>/dev/null || true
set +e
bash $run_dir/apptainer_exec.sh 2>>"$run_dir/live/stderr.log"
rc=\$?
set -e
printf '%s\n' "\$rc" > $run_dir/live/exit_code.txt
if [ "\$rc" -eq 0 ]; then
    printf '{"status":"success","agent":"$agent","mode":"$mode","job_id":"%s"}\n' "\${SLURM_JOB_ID:-}" > $run_dir/live/status.json
else
    printf '{"status":"failed","exit_code":"%s","agent":"$agent","mode":"$mode","job_id":"%s"}\n' "\$rc" "\${SLURM_JOB_ID:-}" > $run_dir/live/status.json
fi
exit "\$rc"
EOF
    chmod +x "$run_dir/apptainer_exec.sh" "$run_dir/submit.sbatch"
}

command_agents() {
    printf 'Available agents:\n'
    for agent in antigravity claude codex; do
        local candidates found role
        candidates="$(agent_candidates "$agent")"
        role="$(agent_role "$agent")"
        found=""
        for cmd in $candidates; do
            if command -v "$cmd" >/dev/null 2>&1; then
                found="$(command -v "$cmd")"
                break
            fi
        done
        if [ -n "$found" ]; then
            printf '  %-12s %-9s available %s\n' "$agent" "$role" "$found"
        else
            printf '  %-12s %-9s missing   %s\n' "$agent" "$role" "$candidates"
        fi
    done
}

codex_hooks_manifest() {
    printf '%s\n' "$ROOT_DIR/agents/codex/hooks.manifest.json"
}

render_codex_hooks_json() {
    local output="$1"
    jq --arg prefix "/home/sandbox/ai-agent-config/common/hooks/" '
      def command_hook:
        . as $name |
        {
          type: "command",
          command: ($prefix + $name),
          timeout: 30
        };
      {
        hooks: {
          PreToolUse: [
            {
              hooks: [(.pre_command // [])[] | command_hook]
            }
          ],
          PostToolUse: [
            {
              hooks: [(.post_command // [])[] | command_hook]
            }
          ]
        }
      }
    ' "$(codex_hooks_manifest)" > "$output"
}

render_codex_requirements_toml() {
    local output="$1"
    local prefix="/home/sandbox/ai-agent-config/common/hooks/"
    {
        printf '[features]\n'
        printf 'hooks = true\n\n'
        printf '[hooks]\n'
        printf 'managed_dir = "%s"\n\n' "${prefix%/}"
        while IFS= read -r hook; do
            [ -n "$hook" ] || continue
            printf '[[hooks.PreToolUse]]\n'
            printf '[[hooks.PreToolUse.hooks]]\n'
            printf 'type = "command"\n'
            printf 'command = "%s%s"\n' "$prefix" "$hook"
            printf 'timeout = 30\n\n'
        done < <(jq -r '(.pre_command // [])[]' "$(codex_hooks_manifest)")
        while IFS= read -r hook; do
            [ -n "$hook" ] || continue
            printf '[[hooks.PostToolUse]]\n'
            printf '[[hooks.PostToolUse.hooks]]\n'
            printf 'type = "command"\n'
            printf 'command = "%s%s"\n' "$prefix" "$hook"
            printf 'timeout = 30\n\n'
        done < <(jq -r '(.post_command // [])[]' "$(codex_hooks_manifest)")
    } > "$output"
}

validate_codex_hook_manifest() {
    local manifest hook failed=0
    manifest="$(codex_hooks_manifest)"
    if [ ! -f "$manifest" ]; then
        printf '[FAIL] agents/codex/hooks.manifest.json\n'
        return 1
    fi
    if ! jq -e '
      type == "object" and
