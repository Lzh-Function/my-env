run_id: {{ run_id }}
mode: {{ mode }}
agent: {{ agent }}
repo: {{ repo }}
goal: {{ goal | default("", true) }}
run_dir: {{ run_dir }}
image: {{ image }}
slurm:
  partition: {{ partition }}
  time: {{ time }}
  memory: {{ memory }}
  cpus_per_task: {{ cpus }}
  gpus: {{ gpus }}
mounts:
  workspace: /workspace
  runs: /runs
  scratch: /scratch
  cache: /cache
  config: /home/sandbox/ai-agent-config
outputs:
  live:
    - status.json
    - heartbeat.txt
    - stdout.log
    - stderr.log
    - command_log.jsonl
  artifacts:
    - report.md
    - git_diff.patch
    - metrics.json
    - environment.txt
    - container.txt
{% if mode in ["experiment", "campaign"] %}
    - proposed_next.yaml
{% endif %}
{% if mode == "campaign" %}
    - proposed_train.sbatch
{% endif %}
{% if mode in ["review", "multi-review"] %}
  reviews:
{% if mode == "review" %}
    - review_findings.json
{% else %}
    - antigravity.md
    - claude.md
    - codex.md
    - summary.md
    - disagreements.json
    - final_recommendation.md
{% endif %}
{% else %}
  reviews: []
{% endif %}
