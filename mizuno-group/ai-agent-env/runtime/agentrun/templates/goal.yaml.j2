project: {{ project | default("agentrun", true) }}
mode: {{ mode }}
agent: {{ agent }}

goal:
  objective: {{ objective | default(user_prompt, true) | tojson }}
  success_criteria:
    - report.md exists
    - metrics.json exists

budgets:
  walltime: {{ time | tojson }}
  cpu_cores: {{ cpus }}
  memory: {{ memory | tojson }}
  gpu_count: {{ gpus }}

outputs:
  required:
    - artifacts/report.md
    - artifacts/git_diff.patch
    - artifacts/metrics.json
    - live/status.json
    - live/heartbeat.txt
    - live/command_log.jsonl
