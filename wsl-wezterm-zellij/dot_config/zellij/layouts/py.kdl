layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    tab name="work" {
        pane split_direction="horizontal" {
            pane size="75%" name="editor" {
                command "bash"
                args "-c" "nvim"
            }
            pane name="container" {
                command "bash"
                args "-c" "docker compose up -d && docker compose exec app bash"
            }
        }
    }
    tab name="monitor" {
        pane name="btop" {
            command "btop"
        }
    }
}
