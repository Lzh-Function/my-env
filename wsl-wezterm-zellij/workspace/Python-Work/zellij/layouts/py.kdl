layout {
    default_tab_template {
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="work" {
        pane split_direction="horizontal" {
            pane size="75%" name="editor" {
                command "nvim"
            }
            pane name="shell" {
                command "bash"
                args "-c" "command -v fastfetch >/dev/null 2>&1 && fastfetch; exec bash"
            }
        }
    }
    tab name="monitor" {
        pane name="btop" {
            command "btop"
        }
    }
}
