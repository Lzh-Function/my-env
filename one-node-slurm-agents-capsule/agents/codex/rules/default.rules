# Shared Codex execution rules for agent capsules.
#
# Capsules launch Codex with --dangerously-bypass-approvals-and-sandbox, which
# skips approval prompts, so "allow" rules have no effect here. Only
# "forbidden" rules are kept. Whether Codex still enforces them in that mode is
# not documented, so the managed hooks in requirements.toml (git_branch_guard.py
# and friends) remain the primary guard; these rules are defense in depth.
#
# Like every command-text rule, these match only the plain prefix: forms such as
# `git -C . push` are not caught. The real boundary for pushes is the scope of the
# GitHub token passed in and branch protection on the remote.
#
# Test with: codex execpolicy check --pretty --rules agents/codex/rules/default.rules -- git push

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Pushing is left to the user. Commit locally and report the branch instead.",
    match = ["git push", "git push origin main"],
    not_match = ["git status"],
)
