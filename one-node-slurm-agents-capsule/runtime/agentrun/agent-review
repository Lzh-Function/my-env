#!/usr/bin/env python3
"""CLI and socket client for the capsule cross-review runtime."""

import argparse
import json
import os
import socket
import sys
from pathlib import Path


def call(action, params, timeout=30):
    endpoint = os.environ.get("AGENT_REVIEW_SOCKET")
    if not endpoint:
        raise ValueError("agent-review is available inside an agentrun capsule")
    with socket.socket(socket.AF_UNIX) as client:
        # The first model listing installs the reviewer CLI, so callers may wait longer.
        client.settimeout(timeout)
        client.connect(endpoint)
        client.sendall(
            (json.dumps({"action": action, "params": params}) + "\n").encode()
        )
        with client.makefile("rb") as stream:
            response = stream.readline(40 * 1024 * 1024 + 1)
        if len(response) > 40 * 1024 * 1024:
            raise ValueError("Review response exceeds size limit")
        result = json.loads(response)
        if "error" in result:
            raise ValueError(result["error"])
        return result["result"]


def provider_values(values):
    """Turn --model codex=MODEL style options into a per-reviewer mapping."""
    result = {}
    for value in values or []:
        provider, separator, choice = value.partition("=")
        if not separator or not provider.strip() or not choice.strip():
            raise ValueError("Use PROVIDER=VALUE, for example --model codex=MODEL")
        if provider.strip() in result:
            raise ValueError("Duplicate value for " + provider.strip())
        result[provider.strip()] = choice.strip()
    return result or None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    sub.add_parser("mcp", help="Expose the same review operations over stdio MCP")
    models = sub.add_parser("models", help="List models the reviewer CLI currently offers")
    models.add_argument("--reviewers", "--reviewer", help="Reviewer names, comma-separated (default: all others)")
    models.add_argument("--refresh", action="store_true", help="Ignore the 10-minute cache")
    for action in ("run", "reply", "recheck", "retry", "status", "events", "cancel", "extend"):
        p = sub.add_parser(action)
        if action != "run":
            p.add_argument("review_id")
        if action in ("run", "reply", "recheck", "retry", "cancel", "extend"):
            p.add_argument("--request-id", required=True)
        if action == "run":
            p.add_argument("--reviewers", "--reviewer", help="Other providers, comma-separated: codex, claude, antigravity")
            p.add_argument("--model", action="append", dest="models", metavar="PROVIDER=MODEL",
                           help="Reviewer model, repeatable; see agent-review models")
            p.add_argument("--effort", action="append", dest="efforts", metavar="PROVIDER=EFFORT")
        if action in ("recheck", "retry"):
            p.add_argument("--model", help="Reviewer model for this round; see agent-review models")
            p.add_argument("--effort")
        if action in ("run", "recheck", "retry"):
            p.add_argument("--model-source", choices=("user", "agent"),
                           help="user only when the user explicitly named the model or effort")
        if action == "retry":
            p.add_argument("--wait", action="store_true")
        if action in ("run", "recheck"):
            p.add_argument("--brief", help="Path to an existing UTF-8 brief file, not inline text")
            p.add_argument("--base")
            p.add_argument("--include", action="append")
            p.add_argument("--exclude", action="append")
            p.add_argument("--wait", action="store_true")
        if action == "run":
            p.add_argument("--kind", choices=("code", "research"), default="research")
            p.add_argument("--one-shot", action="store_true")
        elif action == "reply":
            p.add_argument("--reply-to", required=True)
            p.add_argument("--message-file", type=Path, required=True)
        elif action == "recheck":
            p.add_argument("--response", type=Path, required=True)
        elif action == "events":
            p.add_argument("--after", type=int, default=0)
            p.add_argument("--wait-seconds", type=float, default=0)
        elif action == "extend":
            p.add_argument("--max-rounds", type=int, help="Legacy option; rounds are unlimited")
            p.add_argument("--reason", default="")
            p.add_argument("--user-requested", action="store_true")
    params = vars(parser.parse_args())
    action = params.pop("action")
    if action == "mcp":
        os.execvp(
            "uv",
            [
                "uv",
                "run",
                "--no-project",
                "--python",
                "/usr/bin/python3",
                "--with",
                "mcp==1.26.0",
                "python",
                str(Path(__file__).with_name("review_mcp.py")),
            ],
        )
    wait = params.pop("wait", False)
    if action in ("run", "models") and params.get("reviewers") is not None:
        params["reviewers"] = [value.strip() for value in params["reviewers"].split(",")]
    if action == "run":
        params["models"], params["efforts"] = provider_values(params["models"]), provider_values(params["efforts"])
    if action == "models":
        print(json.dumps(call("models", params, timeout=900), ensure_ascii=False, indent=2))
        return
    for flag, key in (("message_file", "message"), ("response", "response")):
        if flag in params:
            path = params.pop(flag)
            params[key] = json.loads(path.read_text())
    result = call(action, {k: v for k, v in params.items() if v is not None})

    def await_result(state):
        while wait and state["status"] in ("prepared", "running"):
            state = call(
                "events",
                {
                    "review_id": state["review_id"],
                    "after": state["cursor"],
                    "wait_seconds": 20,
                },
            )
        return state

    if "reviews" in result:
        result = {"reviews": [await_result(item) for item in result["reviews"]]}
    else:
        result = await_result(result)
    print(json.dumps(result, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError) as error:
        print("agent-review: " + str(error), file=sys.stderr)
        sys.exit(2)
