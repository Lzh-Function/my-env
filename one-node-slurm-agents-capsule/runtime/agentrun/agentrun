command_resume() {
    local target="" list=0 preview=0 source fields run_dir mode
    AGENT="" REPO="" MEM="" CPUS="" TIME_LIMIT="" GPUS=0 PARTITION="agent" EXTRA_BINDS=()
    GH_BROKER_DISABLED=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -h|--help) usage; return 0 ;;
            --list) list=1; shift ;;
            --preview) preview=1; shift ;;
            --no-gh-broker) GH_BROKER_DISABLED=1; shift ;;
            --time|--mem|--cpus|--bind)
                [ "$#" -ge 2 ] || { printf '%s requires a value\n' "$1" >&2; return 2; }
                case "$1" in
                    --time) TIME_LIMIT="$2" ;;
                    --mem) MEM="$2" ;;
                    --cpus) CPUS="$2" ;;
                    --bind) EXTRA_BINDS+=("$2") ;;
                esac
                shift 2 ;;
            --*) printf 'unknown resume option: %s\n' "$1" >&2; return 2 ;;
            *) [ -z "$target" ] || { printf '指定できる run は1件です\n' >&2; return 2; }
                target="$1"; shift ;;
        esac
    done
    local resume_time="$TIME_LIMIT" resume_mem="$MEM" resume_cpus="$CPUS" resume_disabled="$GH_BROKER_DISABLED"
    local -a resume_binds=("${EXTRA_BINDS[@]}")
    parse_run_args --no-secrets
    TIME_LIMIT="$resume_time" MEM="$resume_mem" CPUS="$resume_cpus" EXTRA_BINDS=("${resume_binds[@]}") GH_BROKER_DISABLED="$resume_disabled"
    resolve_gh_broker || return $?
    if [ "$list" -eq 1 ]; then
        [ -z "$target" ] && [ "$preview" -eq 0 ] || { printf '--list は単独で指定してください\n' >&2; return 2; }
        session_tool list "$PWD/.agent-runs"
        return $?
    fi
    if [ -n "$target" ]; then
        source="$(session_tool resolve "$PWD/.agent-runs" "$target")" || return $?
    else
        source="$(session_tool pick "$PWD/.agent-runs")" || return $?
    fi
    if [ "$preview" -eq 1 ]; then
        session_tool preview "$source"
        return $?
    fi
    fields="$(session_tool fields "$source")" || return $?
    local -a values
    mapfile -t values <<< "$fields"
    AGENT="${values[0]}" REPO="${values[1]}" mode="${values[2]}"
    is_profile "$mode" || { printf '保存された profile が不正です\n' >&2; return 2; }
    [ -d "$REPO" ] || { printf '再開先の repo がありません: %s\n' "$REPO" >&2; return 2; }
    [ -t 0 ] || { printf 'resume には端末が必要です。会話の確認は --preview を使ってください\n' >&2; return 2; }
    local bind
    for bind in "${EXTRA_BINDS[@]+"${EXTRA_BINDS[@]}"}"; do
        [ -e "${bind%%:*}" ] || { printf 'bind source does not exist: %s\n' "${bind%%:*}" >&2; return 2; }
    done
    [ -n "$TIME_LIMIT" ] || TIME_LIMIT="$(profile_time "$mode")"
    # 過去のログを上書きせず、新しい Slurm job 用の run を作る。
    run_dir="$(mktemp -d "$(dirname "$source")/$(run_id "resume-$mode" "$AGENT")_XXXXXX")"
    local RESUME_SOURCE="$source"
    write_plan "$mode" "$AGENT" "$REPO" "" 0 "$TIME_LIMIT" "" "$run_dir" "$PARTITION" interactive || return $?
    printf 'resume: %s → %s\n' "$(basename "$source")" "$(basename "$run_dir")"
    local srun_args=("--nodes=1" "--ntasks=1" "--time=$TIME_LIMIT" "--mem=${MEM:-$(profile_mem "$mode")}" "--cpus-per-task=${CPUS:-$(profile_cpus "$mode")}" "--pty" "--gres=gpu:0")
    [ -z "$PARTITION" ] || srun_args+=("--partition=$PARTITION")
    run_interactive_session "$run_dir" "$REPO" "${srun_args[@]}"
}

