is_remote_skill_source() {
    case "$1" in
        http://*|https://*|git@*|ssh://*|git://*|*.git) return 0 ;;
        *) return 1 ;;
    esac
}

command_skill_install() {
    local source_arg="" force=0
    local -a wanted=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --force) force=1; shift ;;
            -*) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
            *)
                if [ -z "$source_arg" ]; then
                    source_arg="$1"
                else
                    wanted+=("$1")
                fi
                shift
                ;;
        esac
    done
    if [ -z "$source_arg" ]; then
        printf 'usage: agentrun skill-install SOURCE_DIR|GIT_URL [SKILL_NAME...] [--force]\n' >&2
        exit 2
    fi

    local source_dir tmp_clone=""
    if is_remote_skill_source "$source_arg"; then
        command -v git >/dev/null 2>&1 || {
            printf '[FAIL] git is required to clone %s\n' "$source_arg" >&2
            exit 1
        }
        tmp_clone="$(mktemp -d "${TMPDIR:-/tmp}/agentrun-skill-install.XXXXXX")"
        trap "rm -rf $(printf '%q' "$tmp_clone")" EXIT INT TERM
        printf '[..] cloning %s\n' "$source_arg"
        if ! git clone --depth 1 --quiet "$source_arg" "$tmp_clone"; then
            printf '[FAIL] git clone failed: %s\n' "$source_arg" >&2
            exit 1
        fi
        source_dir="$tmp_clone"
    else
        source_dir="$(cd "$source_arg" 2>/dev/null && pwd)" || {
            printf '[FAIL] source directory not found: %s\n' "$source_arg" >&2
            exit 1
        }
    fi
    local skills_dir="$source_dir/skills"
    [ -d "$skills_dir" ] || {
        printf '[FAIL] no skills/ directory under %s\n' "$source_dir" >&2
        exit 1
    }

    local -a candidates=()
    if [ "${#wanted[@]}" -gt 0 ]; then
        candidates=("${wanted[@]}")
    else
        while IFS= read -r d; do
            candidates+=("$(basename "$d")")
        done < <(find "$skills_dir" -mindepth 1 -maxdepth 1 -type d | sort)
    fi

    local installed=0 skipped=0 failed=0 name
    for name in "${candidates[@]}"; do
        local src="$skills_dir/$name"
        if [ ! -d "$src" ]; then
            printf '[FAIL] skill not found: %s\n' "$name" >&2
            failed=1
            continue
        fi
        if [ ! -f "$src/SKILL.md" ]; then
            printf '[SKIP] %s - no SKILL.md\n' "$name"
            skipped=$((skipped + 1))
            continue
        fi
        local dest="$ROOT_DIR/common/skills/$name"
        if [ -e "$dest" ] && [ "$force" -ne 1 ]; then
            printf '[SKIP] %s - already exists in common/skills (use --force to overwrite)\n' "$name"
            skipped=$((skipped + 1))
            continue
        fi
        rm -rf "$dest"
        cp -r "$src" "$dest"
        printf '[OK] installed %s\n' "$name"
        installed=$((installed + 1))
    done

    if [ -n "$tmp_clone" ]; then
        rm -rf "$tmp_clone"
        trap - EXIT INT TERM
    fi

    if [ "$installed" -gt 0 ]; then
        command_sync_claude
        command_sync_codex
    fi

    printf 'skill-install: installed=%d skipped=%d\n' "$installed" "$skipped"
    [ "$failed" -eq 0 ]
}

command_validate() {
    local missing=0
    for path in \
        common/AGENTS.md \
        agents/claude/CLAUDE.md \
        agents/claude/settings.json \
        agents/claude/hooks.manifest.json \
        agents/codex/AGENTS.md \
        agents/codex/config.toml \
        agents/codex/config.assist.toml \
        agents/codex/config.experiment.toml \
        agents/codex/hooks.manifest.json \
        agents/codex/requirements.toml \
        runtime/apptainer/base-system.def \
        runtime/agentrun/sessions.py \
        runtime/agentrun/history.py \
        runtime/agentrun/history_export.py \
        runtime/agentrun/agent-review \
        runtime/agentrun/agent_cli.py \
        runtime/agentrun/review.py \
        runtime/agentrun/review_launch.py \
        runtime/agentrun/review_mcp.py \
        runtime/agentrun/review_snapshot.py \
        common/skills/cross-review/SKILL.md \
        runtime/agentrun/wizard.sh \
        runtime/agentrun/wizard-state.py \
        runtime/agentrun/path-input.py \
        runtime/agentrun/install-agent.sh \
        runtime/agentrun/interactive-runner.py \
        runtime/agentrun/process-cleanup.sh \
        runtime/agentrun/agentrun.bash
    do
        if [ -e "$ROOT_DIR/$path" ]; then
            printf '[OK] %s\n' "$path"
        else
            printf '[FAIL] %s\n' "$path"
            missing=1
        fi
    done
    for profile in assist experiment campaign review multi-review; do
        local profile_path="$ROOT_DIR/profiles/$profile.yaml"
        if [ -e "$profile_path" ]; then
            printf '[OK] profiles/%s.yaml\n' "$profile"
            for key in "name:" "resources:" "outputs:" "policy:"; do
                if grep -q "^$key" "$profile_path"; then
                    printf '[OK] profiles/%s.yaml:%s\n' "$profile" "$key"
                else
                    printf '[FAIL] profiles/%s.yaml:%s\n' "$profile" "$key"
                    missing=1
                fi
            done
        else
            printf '[FAIL] profiles/%s.yaml\n' "$profile"
            missing=1
        fi
    done
    for hook in "$ROOT_DIR"/common/hooks/*; do
        [ -e "$hook" ] || continue
        if [ -x "$hook" ]; then
            printf '[OK] executable:%s\n' "${hook#$ROOT_DIR/}"
        else
            printf '[FAIL] executable:%s\n' "${hook#$ROOT_DIR/}"
            missing=1
        fi
    done
    if command -v jq >/dev/null 2>&1; then
        while IFS= read -r json_file; do
            if jq empty "$json_file" >/dev/null 2>&1; then
                printf '[OK] json:%s\n' "${json_file#$ROOT_DIR/}"
            else
                printf '[FAIL] json:%s\n' "${json_file#$ROOT_DIR/}"
                missing=1
            fi
        done < <(find "$ROOT_DIR/agents" -name '*.json' -type f)
    else
        printf '[FAIL] jq:not-found - JSON validation unavailable\n'
        missing=1
    fi
    while IFS= read -r toml_file; do
        if grep -Eq '^\[.+\]' "$toml_file"; then
            printf '[OK] toml-shape:%s\n' "${toml_file#$ROOT_DIR/}"
        else
            printf '[FAIL] toml-shape:%s\n' "${toml_file#$ROOT_DIR/}"
            missing=1
        fi
    done < <(find "$ROOT_DIR/agents" "$ROOT_DIR/tests" -name '*.toml' -type f)
    while IFS= read -r link; do
        if [ -e "$link" ]; then
            printf '[OK] symlink:%s\n' "${link#$ROOT_DIR/}"
        else
            printf '[FAIL] symlink:%s\n' "${link#$ROOT_DIR/}"
            missing=1
        fi
    done < <(find "$ROOT_DIR" \
        -path "$ROOT_DIR/.git" -prune -o \
        -path "$ROOT_DIR/.agent-runs" -prune -o \
        -type l -print)
    validate_claude_sync || missing=1
    validate_codex_sync || missing=1
    return "$missing"
}

# Nested `apptainer exec` inside the capsule needs three things at once: the host
# device, the shared libraries squashfuse_ll links against, and the --allow-fuse
# bind that lets the capsule see the device. Report all three, never fail the run
# on them — plenty of capsules never nest a container.
check_fuse_support() {
    local image="$ROOT_DIR/runtime/apptainer/base-system.sif"
    if [ -e "$FUSE_DEVICE" ]; then
        printf '[OK] fuse:%s - %s\n' "$FUSE_DEVICE" "$(ls -l "$FUSE_DEVICE" | awk '{print $1}')"
    else
        printf '[WARN] fuse:%s - not present on this host; nested apptainer will fail on nodes without it\n' "$FUSE_DEVICE"
        return 0
    fi
    if ! command -v apptainer >/dev/null 2>&1 || [ ! -e "$image" ]; then
        printf '[WARN] fuse:image-libs - cannot verify without apptainer and base-system.sif on this host\n'
        return 0
    fi
    local missing=""
    local lib
    for lib in libfuse3 liblzo2; do
        if ! apptainer exec "$image" ldconfig -p 2>/dev/null | grep -q "$lib"; then
            missing="${missing:+$missing }$lib"
        fi
    done
    if [ -n "$missing" ]; then
        printf '[WARN] fuse:image-libs - missing in base-system.sif: %s (rebuild the image; see runtime/apptainer/base-system.def)\n' "$missing"
    else
        printf '[OK] fuse:image-libs - libfuse3 and liblzo2 present in base-system.sif\n'
    fi
}

# Secrets are optional, so nothing here fails the doctor run.
check_secrets_file() {
    local file="${AGENTRUN_SECRETS_FILE:-$DEFAULT_SECRETS_FILE}" keys
    if [ ! -f "$file" ]; then
        printf '[WARN] secrets:file - %s not found; no secrets will be passed (template: %s)\n' "$file" "$SECRETS_TEMPLATE"
        return 0
    fi
    if secrets_file_mode_ok "$file"; then
        printf '[OK] secrets:permissions - %s\n' "$(stat -c '%a' "$file")"
    else
        printf '[WARN] secrets:permissions - %s is readable by group/others; run: chmod 600 %s\n' "$file" "$file"
    fi
    keys="$(secret_keys_csv "$file")"
    printf '[OK] secrets:keys - %s\n' "${keys:-<none set>}"
    if path_is_within "$file" "$PWD"; then
        printf '[WARN] secrets:visibility - %s is inside the current directory; running with the default --repo . exposes it via /workspace\n' "$file"
    fi
    return 0
}

check_gh_broker() {
    local file="$DEFAULT_GH_ENV_FILE"
    if [ ! -f "$file" ] || ! file_sets_key "$file" GH_TOKEN; then
        printf '[WARN] gh-broker:disabled - GH_TOKEN not set in %s\n' "$file"
    elif secrets_file_mode_ok "$file"; then
        printf '[OK] gh-broker:token - %s (%s)\n' "$file" "$(stat -c '%a' "$file")"
    else
        printf '[WARN] gh-broker:permissions - %s is readable by group/others; run: chmod 600 %s\n' "$file" "$file"
    fi
    if [ -f "$file" ] && file_sets_key "$file" GH_TOKEN; then
        if file_sets_key "$file" GH_BROKER_REPOS; then
            printf '[OK] gh-broker:repos - %s\n' "$(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?GH_BROKER_REPOS=//p' "$file" | tail -n 1)"
        else
            printf '[WARN] gh-broker:repos - GH_BROKER_REPOS not set; commands may target any repository the token can access\n'
        fi
    fi
    local secrets="${AGENTRUN_SECRETS_FILE:-$DEFAULT_SECRETS_FILE}"
    if [ -f "$secrets" ] && file_sets_key "$secrets" GH_TOKEN; then
        printf '[WARN] gh-broker:bypass - %s sets GH_TOKEN, which hands the token to the agent directly; move it to %s\n' "$secrets" "$file"
    fi
    return 0
}

command_doctor() {
    local agent="$DEFAULT_AGENT" all=0 gpus=0 failed=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --agent) require_supported_agent "$2" || return $?; agent="$2"; shift 2 ;;
            --all) all=1; shift ;;
            --gpus) gpus="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    for cmd in sinfo squeue srun sbatch jq python3; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '[OK] command:%s - %s\n' "$cmd" "$(command -v "$cmd")"
        else
            printf '[FAIL] command:%s - not found\n' "$cmd"
            failed=1
        fi
    done
    for cmd in apptainer uv; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '[OK] command:%s - %s\n' "$cmd" "$(command -v "$cmd")"
        else
            printf '[WARN] command:%s - not found on this host; may be provided on compute nodes or inside the image\n' "$cmd"
        fi
    done
    if [ "$all" -eq 1 ]; then
        command_agents
    else
        command_agents | grep -E "(^Available| $agent[[:space:]])" || true
    fi
    if [ "$all" -eq 1 ]; then
        for auth_agent in "${SUPPORTED_AGENTS[@]}"; do
            check_agent_auth "$auth_agent" || failed=1
        done
    else
        check_agent_auth "$agent" || failed=1
    fi
    if [ -e "$ROOT_DIR/runtime/apptainer/base-system.sif" ]; then
        printf '[OK] image:base-system.sif\n'
    else
        printf '[FAIL] image:base-system.sif - not built\n'
        failed=1
    fi
    check_fuse_support || true
    check_secrets_file || true
    check_gh_broker || true
    if [ -w "$PWD" ]; then
        printf '[OK] writable:%s/.agent-runs\n' "$PWD"
    else
        printf '[FAIL] writable:%s/.agent-runs\n' "$PWD"
        failed=1
    fi
    if [ "$gpus" -gt 0 ]; then
        if command -v nvidia-smi >/dev/null 2>&1; then
            printf '[OK] gpu:nvidia-smi - %s\n' "$(command -v nvidia-smi)"
        else
            printf '[FAIL] gpu:nvidia-smi - not found\n'
            failed=1
        fi
    fi
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf '[OK] git:repo\n'
        printf '[OK] git:branch - %s\n' "$(git branch --show-current 2>/dev/null || true)"
        if git diff --quiet --ignore-submodules -- 2>/dev/null; then
            printf '[OK] git:worktree-clean\n'
        else
            printf '[WARN] git:worktree-dirty\n'
        fi
    else
        printf '[FAIL] git:repo - not inside a git worktree\n'
        failed=1
    fi
    return "$failed"
}

parse_run_args() {
    AGENT="$DEFAULT_AGENT"
    REPO="."
    GOAL=""
    GPUS=0
    MEM=""
    CPUS=""
    TIME_LIMIT=""
    PARTITION="${AGENTRUN_SLURM_PARTITION:-}"
    SHOW_MOUNTS=0
    SUBMIT=0
    REVIEWERS=""
    TARGET_DIFF=""
    TARGET_REPORT=""
    REQUESTED_AGENTS=""
    PROMPT=""
    EXTRA_BINDS=()
    SECRETS_FILE="${AGENTRUN_SECRETS_FILE:-}"
    GH_BROKER_DISABLED=0
    local secrets_explicit=0 no_secrets=0 no_gh_broker=0
    [ -n "$SECRETS_FILE" ] && secrets_explicit=1
    ALLOW_FUSE="${AGENTRUN_ALLOW_FUSE:-0}"
    case "$ALLOW_FUSE" in
        1|true|yes) ALLOW_FUSE=1 ;;
        *) ALLOW_FUSE=0 ;;
    esac
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --agent) require_supported_agent "$2" || return $?; AGENT="$2"; shift 2 ;;
            --repo) REPO="$2"; shift 2 ;;
            --goal) GOAL="$2"; shift 2 ;;
            --gpus) GPUS="$2"; shift 2 ;;
            --mem) MEM="$2"; shift 2 ;;
            --cpus) CPUS="$2"; shift 2 ;;
            --time) TIME_LIMIT="$2"; shift 2 ;;
            --partition) PARTITION="$2"; shift 2 ;;
            --bind) EXTRA_BINDS+=("$2"); shift 2 ;;
            --allow-fuse) ALLOW_FUSE=1; shift ;;
            --no-allow-fuse) ALLOW_FUSE=0; shift ;;
            --secrets-file) SECRETS_FILE="$2"; secrets_explicit=1; no_secrets=0; shift 2 ;;
            --no-secrets) no_secrets=1; shift ;;
            --no-gh-broker) no_gh_broker=1; shift ;;
            --show-mounts) SHOW_MOUNTS=1; shift ;;
            --reviewers) validate_agent_list "$2" || return $?; REVIEWERS="$2"; shift 2 ;;
            --target-diff) TARGET_DIFF="$2"; shift 2 ;;
            --target-report) TARGET_REPORT="$2"; shift 2 ;;
            --agents) validate_agent_list "$2" || return $?; REQUESTED_AGENTS="$2"; shift 2 ;;
            --submit) SUBMIT=1; shift ;;
            --) shift; PROMPT="$*"; break ;;
            --*) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
            *) PROMPT="${PROMPT:+$PROMPT }$1"; shift ;;
        esac
    done
    local bind
    local -a kept_binds=()
    for bind in "${EXTRA_BINDS[@]+"${EXTRA_BINDS[@]}"}"; do
        local src="${bind%%:*}"
        if [ "$src" = "$FUSE_DEVICE" ]; then
            # `--bind /dev/fuse:...` was the manual workaround; fold it into the
            # supported flag so the device is never bound twice.
            ALLOW_FUSE=1
            continue
        fi
        [ -e "$src" ] || { printf 'bind source does not exist: %s\n' "$src" >&2; exit 2; }
        kept_binds+=("$bind")
    done
    EXTRA_BINDS=("${kept_binds[@]+"${kept_binds[@]}"}")
    resolve_secrets_file "$secrets_explicit" "$no_secrets"
    GH_BROKER_DISABLED="$no_gh_broker"
    resolve_gh_broker "$no_gh_broker"
    # agentrun usually runs on a login node while the capsule runs on a compute
    # node, so a missing device here is a warning, never a hard failure.
    if fuse_enabled && [ ! -e "$FUSE_DEVICE" ]; then
        printf 'warning: %s not present on this host; --allow-fuse only works if the compute node exposes it\n' \
            "$FUSE_DEVICE" >&2
    fi
}

resolve_secrets_file() {
    local explicit="$1" disabled="$2"
    if [ "$disabled" -eq 1 ]; then
        SECRETS_FILE=""
        return 0
    fi
    if [ "$explicit" -eq 1 ]; then
        [ -f "$SECRETS_FILE" ] || { printf 'secrets file does not exist: %s\n' "$SECRETS_FILE" >&2; exit 2; }
    elif [ -f "$DEFAULT_SECRETS_FILE" ]; then
        SECRETS_FILE="$DEFAULT_SECRETS_FILE"
    else
        SECRETS_FILE=""
        return 0
    fi
    SECRETS_FILE="$(cd "$(dirname "$SECRETS_FILE")" && pwd -P)/$(basename "$SECRETS_FILE")"
    if ! secrets_file_mode_ok "$SECRETS_FILE"; then
        printf 'warning: %s is readable by group/others; run: chmod 600 %q\n' "$SECRETS_FILE" "$SECRETS_FILE" >&2
    fi
    # The file itself must never be reachable through a mount.
    local bind
    if path_is_within "$SECRETS_FILE" "$REPO"; then
        printf 'warning: secrets file %s is inside --repo %s and is visible to the agent via /workspace\n' \
            "$SECRETS_FILE" "$REPO" >&2
    fi
    for bind in "${EXTRA_BINDS[@]+"${EXTRA_BINDS[@]}"}"; do
        if path_is_within "$SECRETS_FILE" "${bind%%:*}"; then
            printf 'warning: secrets file %s is visible to the agent via --bind %s\n' "$SECRETS_FILE" "$bind" >&2
        fi
    done
}

resolve_gh_broker() {
    local disabled="${1:-${GH_BROKER_DISABLED:-0}}"
    GH_ENV_FILE=""
    if secrets_enabled && file_sets_key "$SECRETS_FILE" GH_TOKEN; then
        printf 'warning: %s sets GH_TOKEN, which hands the token to the agent directly; move it to %s to use the GitHub CLI broker\n' \
            "$SECRETS_FILE" "$DEFAULT_GH_ENV_FILE" >&2
    fi
    [ "$disabled" -eq 0 ] || return 0
    [ -f "$DEFAULT_GH_ENV_FILE" ] && file_sets_key "$DEFAULT_GH_ENV_FILE" GH_TOKEN || return 0
    GH_ENV_FILE="$(cd "$(dirname "$DEFAULT_GH_ENV_FILE")" && pwd -P)/$(basename "$DEFAULT_GH_ENV_FILE")"
    if ! secrets_file_mode_ok "$GH_ENV_FILE"; then
        printf 'warning: %s is readable by group/others; run: chmod 600 %q\n' "$GH_ENV_FILE" "$GH_ENV_FILE" >&2
    fi
    local bind
    if path_is_within "$GH_ENV_FILE" "$REPO"; then
        printf 'warning: %s is inside --repo %s and is visible to the agent via /workspace\n' "$GH_ENV_FILE" "$REPO" >&2
    fi
    for bind in "${EXTRA_BINDS[@]+"${EXTRA_BINDS[@]}"}"; do
        if path_is_within "$GH_ENV_FILE" "${bind%%:*}"; then
            printf 'warning: %s is visible to the agent via --bind %s\n' "$GH_ENV_FILE" "$bind" >&2
        fi
    done
}

command_dry_run() {
    local mode="$1"; shift
    parse_run_args "$@"
    if [ "$mode" = "assist" ] && [ "$SUBMIT" -eq 0 ]; then
        [ -z "$PROMPT" ] || printf 'warning: PROMPT is ignored in interactive assist mode\n' >&2
        PROMPT=""
    else
        [ -n "$PROMPT" ] || { printf 'missing prompt\n' >&2; exit 2; }
    fi
    local id run_dir
    [ -n "$TIME_LIMIT" ] || TIME_LIMIT="$(profile_time "$mode")"
    REPO="$(cd "$REPO" && pwd)"
    id="$(run_id "$mode" "$AGENT")"
    run_dir="$PWD/.agent-runs/$id"
    printf 'run_id: %s\nselected_profile: %s\nselected_agent: %s\nrepo: %s\nhost_run_directory: %s\n' "$id" "$mode" "$AGENT" "$REPO" "$run_dir"
    if [ "$mode" = "assist" ]; then
        if [ "$SUBMIT" -eq 1 ]; then
            printf 'launch_method: sbatch\n'
            printf 'sbatch_args:'
            slurm_partition_args "$PARTITION"
            printf ' --nodes=1 --ntasks=1 --time=%s --mem=%s --cpus-per-task=%s' "$TIME_LIMIT" "${MEM:-$(profile_mem "$mode")}" "${CPUS:-$(profile_cpus "$mode")}"
            printf ' --gres=gpu:%s' "$GPUS"
            printf '\n'
        else
            printf 'launch_method: srun --pty (interactive)\n'
            printf 'slurm_command: srun'
            srun_partition_args "$PARTITION"
            printf ' --nodes=1 --ntasks=1 --time=%s --mem=%s --cpus-per-task=%s --pty' "$TIME_LIMIT" "${MEM:-$(profile_mem "$mode")}" "${CPUS:-$(profile_cpus "$mode")}"
            printf ' --gres=gpu:%s' "$GPUS"
            printf '\n'
        fi
    else
        printf 'launch_method: sbatch\n'
        printf 'sbatch_args:'
        slurm_partition_args "$PARTITION"
        printf ' --nodes=1 --ntasks=1 --time=%s --mem=%s --cpus-per-task=%s' "$TIME_LIMIT" "${MEM:-$(profile_mem "$mode")}" "${CPUS:-$(profile_cpus "$mode")}"
        printf ' --gres=gpu:%s' "$GPUS"
        printf '\n'
    fi
    local launch="batch"
    if [ "$mode" = "assist" ] && [ "$SUBMIT" -eq 0 ]; then
        launch="interactive"
    fi
    printf 'apptainer: '
    apptainer_command "$mode" "$AGENT" "$run_dir" "$GPUS" "$REPO" "$launch"
    printf '\nbind_mounts:\n'
    printf '  /etc/resolv.conf:/etc/resolv.conf:ro\n  /etc/hosts:/etc/hosts:ro\n'
    printf '  %s/home:/home/sandbox\n' "$run_dir"
    printf '  %s:/workspace:rw\n' "$REPO"
    printf '  %s:/runs:rw\n' "$run_dir"
    printf '  %s/scratch:/scratch:rw\n' "$run_dir"
    printf '  %s/cache:/cache:rw\n' "$run_dir"
    shared_config_bind_specs | sed 's/^/  /'
    printf '  %s:/opt/agentrun:ro\n' "$ROOT_DIR/runtime/agentrun"
    local session_mounts session_src session_dst
    session_mounts="$(session_tool mounts "$run_dir" "$AGENT")" || return $?
    while IFS=$'\t' read -r session_src session_dst; do
        printf '  %s:%s:rw\n' "$session_src" "$session_dst"
    done <<< "$session_mounts"
    if fuse_enabled; then
        printf '  %s\n' "$(fuse_bind_spec)"
    fi
    local bind
    for bind in "${EXTRA_BINDS[@]+"${EXTRA_BINDS[@]}"}"; do
        printf '  %s\n' "$bind"
    done
    if [ "$SHOW_MOUNTS" -eq 1 ]; then
        home_config_mounts "$AGENT" "$run_dir" "$mode"
        printf '\n'
    fi
    if secrets_enabled; then
        printf 'secrets_file: %s\nsecret_keys: %s\n' "$SECRETS_FILE" "$(secret_keys_csv "$SECRETS_FILE")"
    else
        printf 'secrets_file: none\n'
    fi
    printf 'gh_broker: %s\n' "$(gh_broker_enabled && printf 'enabled (token: %s)' "$GH_ENV_FILE" || printf 'disabled')"
    printf '\n--- capsule.yaml ---\n'
    printf 'run_id: %s\nmode: %s\nagent: %s\nrepo: %s\ngoal: %s\nallow_fuse: %s\nsecret_keys: %s\ngh_broker: %s\n' \
        "$id" "$mode" "$AGENT" "$REPO" "$GOAL" "$(fuse_enabled && printf 'true' || printf 'false')" \
        "$(secrets_enabled && secret_keys_csv "$SECRETS_FILE")" "$(gh_broker_enabled && printf 'true' || printf 'false')"
    printf '\n--- prompt.txt ---\n'
    local _ptmp
    _ptmp="$(mktemp)"
    write_prompt "$_ptmp" "$mode" "$AGENT" "$REPO" "$PROMPT" "$launch" \
        "${MEM:-$(profile_mem "$mode")}" "${CPUS:-$(profile_cpus "$mode")}" "$GPUS" "$TIME_LIMIT" "$PARTITION"
    cat "$_ptmp"
    rm -f "$_ptmp"
    printf '\n--- expected artifacts ---\n'
    profile_required_outputs "$mode"
}

run_interactive_session() {
    local run_dir="$1" repo_abs="$2"; shift 2
    local history_rc=0
    local terminal_fd="" terminal_state="" runner_pid="" session_started=0 agent_started=0 rc=0 cleanup_done=0

    _cleanup_interactive_session() {
        [ "$cleanup_done" -eq 0 ] || return 0
        cleanup_done=1
        trap '' HUP INT TERM
        if [ "$session_started" -eq 1 ]; then
            # TTY自体が応答しない場合も、終了処理全体を止めない。
            timeout --foreground --kill-after=1s 3s bash -c '
                stty "$1" <&0 2>/dev/null || true
                printf "\033[?9l\033[?1000l\033[?1001l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l\033[?1016l\033[?2004l\033[?1l\033>" >&0
                printf "\033[<u\033[=0u\033[>4;0m\033[?1049l\033[?1047l\033[?47l\033[<u\033[=0u\033[>4;0m\033[0m\033[?25h" >&0
            ' bash "$terminal_state" <&"$terminal_fd" 200>&- || true
            session_started=0
        fi
        if [ -n "$terminal_fd" ]; then
            exec {terminal_fd}>&-
            terminal_fd=""
        fi
        if [ "$agent_started" -eq 1 ] && [ -f "$run_dir/session.json" ]; then
            timeout --kill-after=2s 10s python3 "$ROOT_DIR/runtime/agentrun/sessions.py" finalize "$run_dir" --exit-code "$rc" 200>&- || \
                printf 'セッションの終了記録を完了できませんでした。保存済みの会話はresume時に再検出します。\n' >&2
            history_rc=0
            timeout --kill-after=2s 120s python3 "$ROOT_DIR/runtime/agentrun/history.py" export "$run_dir" 200>&- >> "$run_dir/live/history_export.log" 2>&1 || history_rc=$?
            if [ "$history_rc" -ne 0 ]; then
                case "$history_rc" in
                    124|137) timeout --kill-after=2s 5s python3 "$ROOT_DIR/runtime/agentrun/history.py" failure "$run_dir" "Conversation export timed out (exit=$history_rc); retry with agentrun history" 200>&- || true ;;
                esac
                printf 'warning: conversation export failed (exit=%s); native history is retained; see %s\n' "$history_rc" "$run_dir/live/history_export.log" >&2
            fi
            agent_started=0
        fi
        # 会話の保存後に一時HOMEを削除する。子processにはロックFDを渡さない。
        timeout --kill-after=2s 15s bash -c 'source "$1"; _agentrun_cleanup_home "$2"' bash "$ROOT_DIR/runtime/agentrun/process-cleanup.sh" "$run_dir" 200>&- || \
            printf '一時homeの削除を完了できませんでした: %s/home（exit=%s、詳細: live/home_cleanup.log）\n' "$run_dir" "$?" >&2
        exec 200>&-
    }

    _stop_interactive_session() {
        local signal_status="$1" _stop_wait
        rc="$signal_status"
        trap '' HUP INT TERM
        if [ -n "$runner_pid" ]; then
            kill -TERM "$runner_pid" 2>/dev/null || true
            # 監視processへの停止要求も無期限には待たない。
            for _stop_wait in {1..100}; do
                kill -0 "$runner_pid" 2>/dev/null || break
                sleep 0.1 200>&-
            done
            if kill -0 "$runner_pid" 2>/dev/null; then
                kill -KILL "$runner_pid" 2>/dev/null || true
            else
                wait "$runner_pid" 2>/dev/null || true
            fi
        fi
        exit "$signal_status"
    }

    trap _cleanup_interactive_session EXIT
    trap '_stop_interactive_session 129' HUP
    trap '_stop_interactive_session 130' INT
    trap '_stop_interactive_session 143' TERM
    if ! { exec {terminal_fd}<>/dev/tty; } 2>/dev/null; then
        printf 'interactive assist requires a controlling terminal; use --submit for batch runs\n' >&2
        rc=1
        exit 1
    fi
    terminal_state="$(stty -g <&"$terminal_fd")"
    copy_auth_credentials "$run_dir" "$AGENT"
    exec 200>"$repo_abs/.agentrun.lock"
    if ! flock -n 200; then
        printf 'another agentrun is already active on this repo (%s). Refusing to start to avoid concurrent git operations.\n' "$repo_abs" >&2
        rc=1
    else
        printf 'launching interactive session via srun %s\n' "$*"
        session_started=1
        agent_started=1
        # ロックを持つlauncher/監視processと、FDを継承しないsrunを分ける。
        python3 "$ROOT_DIR/runtime/agentrun/interactive-runner.py" "$run_dir" srun "$@" bash "$run_dir/apptainer_exec.sh" <&0 &
        runner_pid=$!
        wait "$runner_pid" || rc=$?
        runner_pid=""
    fi
    _cleanup_interactive_session
    trap - EXIT HUP INT TERM
    return "$rc"
}

command_prepare() {
    local mode="$1"; shift
    ensure_default_secrets_file
    ensure_default_gh_env_file
    parse_run_args "$@"
    if [ "$mode" = "assist" ] && [ "$SUBMIT" -eq 0 ]; then
        [ -z "$PROMPT" ] || printf 'warning: PROMPT is ignored in interactive assist mode\n' >&2
        PROMPT=""
        [ -t 0 ] || { printf 'interactive assist requires a terminal; use --submit for batch runs\n' >&2; return 1; }
    else
        [ -n "$PROMPT" ] || { printf 'missing prompt\n' >&2; exit 2; }
    fi
    local run_dir
    [ -n "$TIME_LIMIT" ] || TIME_LIMIT="$(profile_time "$mode")"
    run_dir="$(allocate_run_dir "$mode" "$AGENT")" || return $?
    local launch="batch"
    if [ "$mode" = "assist" ] && [ "$SUBMIT" -eq 0 ]; then
        launch="interactive"
    fi
    write_plan "$mode" "$AGENT" "$REPO" "$GOAL" "$GPUS" "$TIME_LIMIT" "$PROMPT" "$run_dir" "$PARTITION" "$launch" || return $?
    printf 'prepared run: %s\n' "$run_dir"
    if [ "$mode" = "assist" ] && [ "$SUBMIT" -eq 0 ]; then
        local repo_abs
        repo_abs="$(cd "$REPO" && pwd)"
        local srun_args=("--nodes=1" "--ntasks=1" "--time=$TIME_LIMIT" "--mem=${MEM:-$(profile_mem "$mode")}" "--cpus-per-task=${CPUS:-$(profile_cpus "$mode")}" "--pty")
        [ -n "$PARTITION" ] && srun_args+=("--partition=$PARTITION")
        srun_args+=("--gres=gpu:$GPUS")
        run_interactive_session "$run_dir" "$repo_abs" "${srun_args[@]}"
        return $?
    fi
    printf 'submit script: %s\n' "$run_dir/submit.sbatch"
    if [ "$SUBMIT" -eq 1 ]; then
        copy_auth_credentials "$run_dir" "$AGENT"
        history_tool submit "$run_dir"
    elif [ "$AGENT" = "claude" ] || [ "$AGENT" = "codex" ]; then
        printf 'auth credentials were not staged; rerun with --submit to copy them before sbatch\n'
    fi
}

command_smoke_test() {
    local agent="$DEFAULT_AGENT"
    local submit=0 partition="${AGENTRUN_SLURM_PARTITION:-}" time_limit="00:10:00" mem="4000M"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --agent) require_supported_agent "$2" || return $?; agent="$2"; shift 2 ;;
            --partition) partition="$2"; shift 2 ;;
            --time) time_limit="$2"; shift 2 ;;
            --mem) mem="$2"; shift 2 ;;
            --submit) submit=1; shift ;;
            *) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
        esac
    done
    local id run_dir
    run_dir="$(allocate_run_dir smoke-test "$agent")" || return $?
    id="$(basename "$run_dir")"
    make_layout "$run_dir"
    cat > "$run_dir/live/status.json" <<EOF
{"status":"prepared","agent":"$agent","mode":"smoke-test","note":"submit.sbatch must run on a Slurm compute node to complete this smoke test"}
EOF
    printf 'run_id: %s\nagent: %s\nmode: smoke-test\n' "$id" "$agent" > "$run_dir/capsule.yaml"
    printf 'Write {"smoke_test": true, "status": "passed"} to /runs/artifacts/metrics.json.\n' > "$run_dir/prompt.txt"
    printf 'mode: smoke-test\nagent: %s\n' "$agent" > "$run_dir/goal.yaml"
    cat > "$run_dir/submit.sbatch" <<EOF
#!/usr/bin/env bash
#SBATCH --job-name=agentrun-smoke-$agent
EOF
    slurm_partition_args "$partition" >> "$run_dir/submit.sbatch"
    cat >> "$run_dir/submit.sbatch" <<EOF
#SBATCH --time=$time_limit
#SBATCH --mem=$mem
#SBATCH --cpus-per-task=1
#SBATCH --nodes=1
#SBATCH --ntasks=1
EOF
    slurm_log_directives "$run_dir" >> "$run_dir/submit.sbatch"
    cat >> "$run_dir/submit.sbatch" <<EOF

set -euo pipefail
run_dir=$(printf '%q' "$run_dir")
_cleanup_home() {
    timeout --kill-after=2s 15s bash -c 'source "\$1"; _agentrun_cleanup_home "\$2"' bash $(printf '%q' "$ROOT_DIR/runtime/agentrun/process-cleanup.sh") "\$run_dir" || \
        printf '一時homeの削除を完了できませんでした: %s/home（exit=%s、詳細: live/home_cleanup.log）\n' "\$run_dir" "\$?" >&2
}
trap _cleanup_home EXIT
printf '%s\n' "\${SLURM_JOB_ID:-}" > "\$run_dir/live/slurm_job_id.txt"
printf '{"status":"running","agent":"%s","mode":"smoke-test","job_id":"%s"}\n' "$agent" "\${SLURM_JOB_ID:-}" > "\$run_dir/live/status.json"
date -Iseconds > "\$run_dir/live/heartbeat.txt"
printf 'Smoke test running on node %s\n' "\${SLURMD_NODENAME:-unknown}" > "\$run_dir/live/stdout.log"
: > "\$run_dir/live/stderr.log"
printf '{"event":"smoke-test","agent":"%s","status":"running","job_id":"%s"}\n' "$agent" "\${SLURM_JOB_ID:-}" > "\$run_dir/live/command_log.jsonl"
printf '{"event":"slurm-job","status":"running"}\n' > "\$run_dir/live/events.jsonl"
printf 'Smoke test completed on compute node.\n' > "\$run_dir/live/current_task.md"
: > "\$run_dir/artifacts/git_diff.patch"
printf '# Smoke Test Report\n\nPassed on Slurm job %s.\n' "\${SLURM_JOB_ID:-}" > "\$run_dir/artifacts/report.md"
printf 'verified capsule smoke test execution\n' > "\$run_dir/artifacts/run_title.txt"
printf '{"smoke_test":true,"status":"passed","agent":"%s","job_id":"%s"}\n' "$agent" "\${SLURM_JOB_ID:-}" > "\$run_dir/artifacts/metrics.json"
printf '{"status":"success","agent":"%s","mode":"smoke-test","job_id":"%s"}\n' "$agent" "\${SLURM_JOB_ID:-}" > "\$run_dir/live/status.json"
printf '0\n' > "\$run_dir/live/exit_code.txt"
EOF
    chmod +x "$run_dir/submit.sbatch"
    printf 'prepared smoke-test run: %s\n' "$run_dir"
    printf 'submit script: %s\n' "$run_dir/submit.sbatch"
    if [ "$submit" -eq 1 ]; then
        sbatch --nodes=1 --ntasks=1 "$run_dir/submit.sbatch"
    fi
}

