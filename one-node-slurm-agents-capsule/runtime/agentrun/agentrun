command_verify_run() {
    local run_dir=""
    if [ "${1:-}" = "--run-id" ]; then
        run_dir="$PWD/.agent-runs/$2"
    else
        run_dir="${1:-$PWD/.agent-runs/latest}"
    fi
    [ -L "$run_dir" ] && run_dir="$(readlink -f "$run_dir")"
    local failed=0
    if [ ! -d "$run_dir" ]; then
        printf '[FAIL] run directory: %s\n' "$run_dir"
        return 1
    fi
    printf '[OK] run directory: %s\n' "$run_dir"
    for path in capsule.yaml prompt.txt goal.yaml; do
        if [ -e "$run_dir/$path" ]; then
            printf '[OK] %s\n' "$path"
        else
            printf '[FAIL] %s\n' "$path"
            failed=1
        fi
    done
    for path in artifacts/report.md artifacts/run_title.txt; do
        if [ -s "$run_dir/$path" ]; then
            printf '[OK] nonempty:%s\n' "$path"
        else
            printf '[FAIL] nonempty:%s\n' "$path"
            failed=1
        fi
    done
    local mode
    mode="$(sed -n 's/^mode:[[:space:]]*//p' "$run_dir/capsule.yaml" 2>/dev/null | sed -n '1p')"
    if [ -n "$mode" ] && profile_required_outputs "$mode" >/dev/null 2>&1; then
        while IFS= read -r path; do
            [ -n "$path" ] || continue
            if [ -e "$run_dir/$path" ]; then
                printf '[OK] profile_required:%s\n' "$path"
            else
                printf '[FAIL] profile_required:%s\n' "$path"
                failed=1
            fi
        done < <(profile_required_outputs "$mode")
    else
        printf '[FAIL] profile_required:unknown-mode:%s\n' "${mode:-missing}"
        failed=1
    fi
    if command -v jq >/dev/null 2>&1; then
        for json_file in live/status.json artifacts/metrics.json; do
            if [ -e "$run_dir/$json_file" ] && jq empty "$run_dir/$json_file" >/dev/null 2>&1; then
                printf '[OK] json:%s\n' "$json_file"
            else
                printf '[FAIL] json:%s\n' "$json_file"
                failed=1
            fi
        done
        if [ -e "$run_dir/live/command_log.jsonl" ]; then
            if sed '/^[[:space:]]*$/d' "$run_dir/live/command_log.jsonl" | jq -c . >/dev/null 2>&1; then
                printf '[OK] jsonl:live/command_log.jsonl\n'
            else
                printf '[FAIL] jsonl:live/command_log.jsonl\n'
                failed=1
            fi
        fi
        if [ -e "$run_dir/live/events.jsonl" ]; then
            if sed '/^[[:space:]]*$/d' "$run_dir/live/events.jsonl" | jq -c . >/dev/null 2>&1; then
                printf '[OK] jsonl:live/events.jsonl\n'
            else
                printf '[FAIL] jsonl:live/events.jsonl\n'
                failed=1
            fi
        fi
        if [ -e "$run_dir/live/status.json" ]; then
            local final_status
            final_status="$(jq -r '.status // empty' "$run_dir/live/status.json" 2>/dev/null || true)"
            case "$final_status" in
                success|failed|cancelled|timeout)
                    printf '[OK] final_status:%s\n' "$final_status"
                    ;;
                *)
                    printf '[FAIL] final_status:%s\n' "${final_status:-missing}"
                    failed=1
                    ;;
            esac
        fi
    else
        printf '[FAIL] jq:not-found - JSON/JSONL verification unavailable\n'
        failed=1
    fi
    if [ -e "$run_dir/live/exit_code.txt" ]; then
        printf '[OK] exit_code\n'
    else
        printf '[FAIL] exit_code missing\n'
        failed=1
    fi
    if [ -e "$run_dir/live/slurm_job_id.txt" ]; then
        printf '[OK] slurm_job_id\n'
    else
        printf '[FAIL] slurm_job_id missing\n'
        failed=1
    fi
    return "$failed"
}

_auth_import_file() {
    local host_path="$1" store_path="$2"
    if [ ! -f "$host_path" ]; then
        printf '[SKIP] %s - not found on host\n' "$host_path"
        return 0
    fi
    mkdir -p "$(dirname "$store_path")"
    cp "$host_path" "$store_path"
    chmod 600 "$store_path"
    printf '[IMPORTED] %s -> %s\n' "$host_path" "$store_path"
}

_auth_login_agent() {
    local agent="$1"
    local cmd
    case "$agent" in
        claude)
            cmd="claude auth login"
            ;;
        codex)
            cmd="codex login"
            ;;
        *)
            printf '[FAIL] unknown agent: %s\n' "$agent" >&2
            return 1
            ;;
    esac
    printf '\n[auth login] %s\n' "$agent"
    local cli
    cli="$(printf '%s' "$cmd" | awk '{print $1}')"
    if ! command -v "$cli" >/dev/null 2>&1; then
        printf '[FAIL] CLI not found on host: %s\n' "$cli" >&2
        return 1
    fi
    eval "$cmd"
    printf '\n[auth import] syncing to store\n'
    _auth_import_agent "$agent"
}

_auth_import_agent() {
    local agent="$1"
    local store_root
    store_root="$(auth_store_root)/$agent"
    case "$agent" in
        claude)
            _auth_import_file "$HOME/.claude/.credentials.json" "$store_root/.claude/.credentials.json"
            _auth_import_file "$HOME/.claude.json" "$store_root/.claude.json"
            ;;
        codex)
            _auth_import_file "$HOME/.codex/auth.json" "$store_root/.codex/auth.json"
            ;;
        *)
            printf '[FAIL] unknown agent: %s\n' "$agent" >&2
            return 1
            ;;
    esac
}

_auth_status_agent() {
    local agent="$1"
    local store_root
    store_root="$(auth_store_root)/$agent"
    _show_status() {
        local rel="$1"
        local store_f="$store_root/$rel" host_f="$HOME/$rel"
        local s h
        [ -f "$store_f" ] && s="present" || s="missing"
        [ -f "$host_f" ]  && h="present" || h="missing"
        printf '  %-50s  store:%-8s  host:%s\n' "$rel" "$s" "$h"
    }
    printf '%s:\n' "$agent"
    case "$agent" in
        claude)
            _show_status ".claude/.credentials.json"
            _show_status ".claude.json"
            ;;
        codex)
            _show_status ".codex/auth.json"
            ;;
    esac
    unset -f _show_status
}

command_auth() {
    local subcmd="${1:-}"
    [ -n "$subcmd" ] || { printf 'usage: agentrun auth login|import|status|reset\n' >&2; exit 2; }
    shift || true
    case "$subcmd" in
        login)
            local agent_arg="" do_all=0
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --agent) require_supported_agent "$2" || return $?; agent_arg="$2"; shift 2 ;;
                    --all) do_all=1; shift ;;
                    *) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
                esac
            done
            if [ "$do_all" -eq 1 ]; then
                for a in "${SUPPORTED_AGENTS[@]}"; do _auth_login_agent "$a"; done
            elif [ -n "$agent_arg" ]; then
                _auth_login_agent "$agent_arg"
            else
                printf 'usage: agentrun auth login --agent NAME|--all\n' >&2; exit 2
            fi
            ;;
        import)
            local agent_arg="" do_all=0
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --agent) require_supported_agent "$2" || return $?; agent_arg="$2"; shift 2 ;;
                    --all) do_all=1; shift ;;
                    *) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
                esac
            done
            if [ "$do_all" -eq 1 ]; then
                for a in "${SUPPORTED_AGENTS[@]}"; do _auth_import_agent "$a"; done
            elif [ -n "$agent_arg" ]; then
                _auth_import_agent "$agent_arg"
            else
                printf 'usage: agentrun auth import --agent NAME|--all\n' >&2; exit 2
            fi
            ;;
        status)
            local agent_arg=""
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --agent) require_supported_agent "$2" || return $?; agent_arg="$2"; shift 2 ;;
                    *) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
                esac
            done
            if [ -n "$agent_arg" ]; then
                _auth_status_agent "$agent_arg"
            else
                for a in "${SUPPORTED_AGENTS[@]}"; do _auth_status_agent "$a"; done
            fi
            ;;
        reset)
            local agent_arg=""
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --agent) require_supported_agent "$2" || return $?; agent_arg="$2"; shift 2 ;;
                    *) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
                esac
            done
            [ -n "$agent_arg" ] || { printf 'usage: agentrun auth reset --agent NAME\n' >&2; exit 2; }
            local store_dir
            store_dir="$(auth_store_root)/$agent_arg"
            if [ -d "$store_dir" ]; then
                rm -rf "$store_dir"
                printf '[OK] auth store removed: %s\n' "$store_dir"
            else
                printf '[OK] auth store not found (nothing to reset): %s\n' "$store_dir"
            fi
            ;;
        *)
            printf 'unknown auth subcommand: %s\n' "$subcmd" >&2; exit 2
            ;;
    esac
}

main() {
    local command="${1:-}"
    [ -n "$command" ] || { usage; exit 2; }
    shift || true
    case "$command" in
        agents) command_agents "$@" ;;
        sync-claude) command_sync_claude "$@" ;;
        sync-codex) command_sync_codex "$@" ;;
        validate) command_validate "$@" ;;
        doctor) command_doctor "$@" ;;
        dry-run)
            [ "$#" -ge 1 ] && is_profile "$1" || { usage; exit 2; }
            local mode="$1"; shift
            command_dry_run "$mode" "$@"
            ;;
        assist|experiment|campaign|review|multi-review) command_prepare "$command" "$@" ;;
        resume) command_resume "$@" ;;
        history) command_history "$@" ;;
        wizard) command_wizard "$@" ;;
        skill-install) command_skill_install "$@" ;;
        smoke-test) command_smoke_test "$@" ;;
        init-goal) command_init_goal "$@" ;;
        status) command_status "$@" ;;
        logs) command_logs "$@" ;;
        tail) command_logs --follow ;;
        list-runs) command_list_runs "$@" ;;
        open-run) command_open_run "$@" ;;
        verify-run) command_verify_run "$@" ;;
        auth) command_auth "$@" ;;
        -h|--help|help) usage ;;
        *) printf 'unknown command: %s\n' "$command" >&2; usage; exit 2 ;;
    esac
}

[[ "${BASH_SOURCE[0]}" != "${0}" ]] || main "$@"
