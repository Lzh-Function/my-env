    ln -sfnT ../../common/AGENTS.md "$ROOT_DIR/agents/claude/CLAUDE.md"
    ln -sfnT ../../common/skills "$ROOT_DIR/agents/claude/skills"
    printf '[OK] synced agents/claude/settings.json hooks from agents/claude/hooks.manifest.json\n'
    printf '[OK] synced agents/claude/CLAUDE.md -> ../../common/AGENTS.md\n'
    printf '[OK] synced agents/claude/skills -> ../../common/skills\n'
}

