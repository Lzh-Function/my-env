session_tool() {
    command -v python3 >/dev/null 2>&1 || {
        printf 'セッション管理にはホストの python3 が必要です\n' >&2
        return 2
    }
    python3 "$ROOT_DIR/runtime/agentrun/sessions.py" "$@"
}

history_tool() {
    python3 "$ROOT_DIR/runtime/agentrun/history.py" "$@"
}

command_history() {
    local target="" watch=0 run_dir
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --watch) watch=1; shift ;;
            --*) printf 'unknown history option: %s\n' "$1" >&2; return 2 ;;
            *) [ -z "$target" ] || { printf 'history accepts one run\n' >&2; return 2; }
               target="$1"; shift ;;
        esac
    done
    run_dir="$(session_tool resolve "$PWD/.agent-runs" "${target:-$PWD/.agent-runs/latest}")" || return $?
    if [ "$watch" -eq 1 ]; then
        history_tool collect "$run_dir"
    else
        history_tool export "$run_dir"
    fi
}

apptainer_command() {
    local mode="$1" agent="$2" run_dir="$3" gpus="$4" repo="${5:-$PWD}" launch="${6:-batch}"
    local nv="" image="$ROOT_DIR/runtime/apptainer/base-system.sif"
    [ "$gpus" -gt 0 ] && nv=" --nv"
    local cmd runtime_setup=""
    cmd="$(agent_command "$agent" "$mode" "$launch")"
    if [ -f "$run_dir/session.json" ] && [ -n "${RESUME_SOURCE:-}" ]; then
        cmd="$(session_tool command "$run_dir")" || return $?
    fi
    if [ "$agent" = codex ]; then
        # Codex deletes arg0 helpers while their lock file is open. On NFS this
        # leaves .nfs* files and causes ENOTEMPTY. Only tmp lives in the private
        # container /tmp; config, auth and persisted session mounts stay put.
        # Prepare before install-agent's --version check, which also uses arg0.
        runtime_setup='mkdir -p "$HOME/.codex" || exit $?; AGENTRUN_CODEX_TMP=$(mktemp -d /tmp/agentrun-codex.XXXXXX) || exit $?; trap '\''rm -rf -- "$AGENTRUN_CODEX_TMP"'\'' EXIT; ln -sfnT "$AGENTRUN_CODEX_TMP" "$HOME/.codex/tmp" || exit $?; '
    fi
    if [ "$agent" = claude ]; then
        cmd="${cmd/claude /claude --mcp-config /runs/container_config/review-mcp.json }"
    fi
    local worker_command
    worker_command="$(python3 -c 'import shlex, sys; print(shlex.quote(sys.argv[1]))' "$cmd")"
    cmd="${runtime_setup}AGENTRUN_AGENT_BIN=\$(bash /opt/agentrun/install-agent.sh $(printf '%q' "$agent")) || exit \$?; export PATH=\"\$AGENTRUN_AGENT_BIN:\$PATH\"; hash -r; unset -f claude codex; python3 /opt/agentrun/review_launch.py --agent $(printf '%q' "$agent") -- bash -c ${worker_command}"
    # Do not inherit implicit host mounts or inject GitHub broker credentials.
    printf '%s\n' 'unset APPTAINER_BIND APPTAINER_BINDPATH APPTAINER_MOUNT SINGULARITY_BIND SINGULARITY_BINDPATH SINGULARITY_MOUNT'
    printf '%s\n' 'unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN APPTAINERENV_GH_TOKEN APPTAINERENV_GITHUB_TOKEN APPTAINERENV_GH_ENTERPRISE_TOKEN APPTAINERENV_GITHUB_ENTERPRISE_TOKEN SINGULARITYENV_GH_TOKEN SINGULARITYENV_GITHUB_TOKEN SINGULARITYENV_GH_ENTERPRISE_TOKEN SINGULARITYENV_GITHUB_ENTERPRISE_TOKEN'
    printf 'source %q\n' "$ROOT_DIR/runtime/agentrun/process-cleanup.sh"
    printf 'printf "%%s\\n" "${SLURM_JOB_ID:-}" > %q\n' "$run_dir/live/slurm_job_id.txt"
    if gh_broker_enabled; then
        gh_broker_launch_lines "$run_dir" "$image"
    fi
    printf 'export APPTAINERENV_SLURM_JOB_ID="${SLURM_JOB_ID:-}"\n'
    printf 'export APPTAINERENV_SLURMD_NODENAME="${SLURMD_NODENAME:-}"\n'
    printf 'export APPTAINERENV_SLURM_CPUS_PER_TASK="${SLURM_CPUS_PER_TASK:-}"\n'
    printf 'export APPTAINERENV_SLURM_MEM_PER_NODE="${SLURM_MEM_PER_NODE:-}"\n'
    printf 'export APPTAINERENV_SLURM_GPUS="${SLURM_GPUS:-}"\n'
    printf 'export APPTAINERENV_SLURM_JOB_END_TIME="${SLURM_JOB_END_TIME:-}"\n'
    printf 'apptainer exec%s --containall --cleanenv --no-mount hostfs,bind-paths,cwd --pwd /workspace --home %q:%q --bind %q:%q --bind %q:%q --bind %q:%q --bind %q:%q' \
        "$nv" \
        "$run_dir/home" "/home/sandbox" \
        "$repo" "/workspace:rw" \
        "$run_dir" "/runs:rw" \
        "$run_dir/scratch" "/scratch:rw" \
        "$run_dir/cache" "/cache:rw"
    printf ' --bind /etc/resolv.conf:/etc/resolv.conf:ro --bind /etc/hosts:/etc/hosts:ro'
    local spec
    while IFS= read -r spec; do
        printf ' --bind %q' "$spec"
    done < <(shared_config_bind_specs)
    if secrets_enabled; then
        printf ' --env-file %q' "$SECRETS_FILE"
    fi
    if gh_broker_enabled; then
        printf ' --bind "$GH_BROKER_DIR":%s:ro --bind %q:/usr/local/bin/gh:ro' \
            "$GH_BROKER_CONTAINER_DIR" "$GH_BROKER_SRC/gh-client"
    fi
    printf ' --bind %q:/opt/agentrun:ro' "$ROOT_DIR/runtime/agentrun"
    local review_key
    for review_key in AGENT_REVIEW_CODEX_MODEL AGENT_REVIEW_CODEX_EFFORT \
        AGENT_REVIEW_CLAUDE_MODEL AGENT_REVIEW_CLAUDE_EFFORT AGENT_REVIEW_MAX_EXCHANGES \
        AGENT_REVIEW_ACTIVE_TIMEOUT AGENT_REVIEW_REPLY_TIMEOUT AGENT_REVIEW_THREAD_TIMEOUT; do
        if [ -n "${!review_key:-}" ]; then
            printf ' --env %q' "$review_key=${!review_key}"
        fi
    done
    if [ "$agent" = "claude" ]; then
        printf ' --env CLAUDE_CODE_TMPDIR=/scratch/claude'
    fi
    home_config_mounts "$agent" "$run_dir" "$mode"
    local session_mounts session_src session_dst
    session_mounts="$(session_tool mounts "$run_dir" "$agent")" || return $?
    while IFS=$'\t' read -r session_src session_dst; do
        printf ' --bind %q:%q:rw' "$session_src" "$session_dst"
    done <<< "$session_mounts"
    if fuse_enabled; then
        printf ' --bind %q:%q:rw' "$FUSE_DEVICE" "$FUSE_DEVICE"
    fi
    local bind
    for bind in "${EXTRA_BINDS[@]+"${EXTRA_BINDS[@]}"}"; do
        printf ' --bind %q' "$bind"
    done
    printf ' %q bash -l -c %q\n' "$image" "$cmd"
}

write_plan() {
    local mode="$1" agent="$2" repo="$3" goal="$4" gpus="$5" time_limit="$6" prompt="$7" run_dir="$8" partition="${9:-}" launch="${10:-batch}"
    local cpus mem _runs_dir _run_base
    cpus="${CPUS:-$(profile_cpus "$mode")}"
    mem="${MEM:-$(profile_mem "$mode")}"
    repo="$(cd "$repo" && pwd)"
    _runs_dir="$(dirname "$run_dir")"
    _run_base="$(basename "$run_dir")"
    make_layout "$run_dir"
    local session_args=(init "$run_dir" "$agent" "$repo" "$mode")
    [ -z "${RESUME_SOURCE:-}" ] || session_args+=("$RESUME_SOURCE")
    session_tool "${session_args[@]}" || return $?
    generate_container_config "$run_dir" "$agent" "$mode"
    if [ "$agent" = "claude" ]; then
        mkdir -p "$run_dir/scratch/claude"
    fi
    if [ "$agent" = "codex" ]; then
        link_codex_shared_assets "$run_dir"
    fi
    write_prompt "$run_dir/prompt.txt" "$mode" "$agent" "$repo" "$prompt" "$launch" \
        "$mem" "$cpus" "$gpus" "$time_limit" "$partition"
    if [ -n "$goal" ]; then
        cp "$goal" "$run_dir/goal.yaml"
    else
        printf 'mode: %s\nagent: %s\n' "$mode" "$agent" > "$run_dir/goal.yaml"
    fi
    cat > "$run_dir/capsule.yaml" <<EOF
run_id: $(basename "$run_dir")
mode: $mode
agent: $agent
repo: $repo
goal: $goal
allow_fuse: $(fuse_enabled && printf 'true' || printf 'false')
secret_keys: $(secrets_enabled && secret_keys_csv "$SECRETS_FILE")
gh_broker: $(gh_broker_enabled && printf 'true' || printf 'false')
EOF
    apptainer_command "$mode" "$agent" "$run_dir" "$gpus" "$repo" "$launch" > "$run_dir/apptainer_exec.sh" || return $?
    sed -i '1i#!/usr/bin/env bash\nset -euo pipefail' "$run_dir/apptainer_exec.sh"
    cat > "$run_dir/submit.sbatch" <<EOF
#!/usr/bin/env bash
#SBATCH --job-name=agentrun-$mode-$agent
EOF
    slurm_partition_args "$partition" >> "$run_dir/submit.sbatch"
    cat >> "$run_dir/submit.sbatch" <<EOF
#SBATCH --time=$time_limit
#SBATCH --mem=$mem
#SBATCH --cpus-per-task=$cpus
#SBATCH --nodes=1
#SBATCH --ntasks=1
EOF
    printf '#SBATCH --gres=gpu:%s\n' "$gpus" >> "$run_dir/submit.sbatch"
    slurm_log_directives "$run_dir" >> "$run_dir/submit.sbatch"
    cat >> "$run_dir/submit.sbatch" <<EOF

set -euo pipefail
run_dir=$(printf '%q' "$run_dir")
repo=$(printf '%q' "$repo")
runs_dir=$(printf '%q' "$_runs_dir")
run_base=$(printf '%q' "$_run_base")
session_helper=$(printf '%q' "$ROOT_DIR/runtime/agentrun/sessions.py")
cleanup_done=0
_cleanup_home() {
    local cleanup_rc=\$?
    local final_rc=\${rc:-\$cleanup_rc}
    [ "\$cleanup_done" -eq 0 ] || return 0
    cleanup_done=1
    trap '' HUP INT TERM
    timeout --kill-after=2s 15s bash -c 'source "\$1"; _agentrun_cleanup_home "\$2"' bash $(printf '%q' "$ROOT_DIR/runtime/agentrun/process-cleanup.sh") "\$run_dir" 200>&- || \
        printf '一時homeの削除を完了できませんでした: %s/home（exit=%s、詳細: live/home_cleanup.log）\n' "\$run_dir" "\$?" >&2
    timeout --kill-after=2s 10s python3 "\$session_helper" finalize "\$run_dir" --exit-code "\$final_rc" 200>&- || \
        printf 'セッションの終了記録を完了できませんでした。保存済みの会話はresume時に再検出します。\n' >&2
    exec 200>&-
    date -Iseconds > "\$run_dir/live/session_finished.txt.tmp"
    mv "\$run_dir/live/session_finished.txt.tmp" "\$run_dir/live/session_finished.txt"
}
trap _cleanup_home EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
printf '%s\n' "\${SLURM_JOB_ID:-}" > "\$run_dir/live/slurm_job_id.txt"
python3 -c 'import os; keys = ["SLURM_JOB_ID", "SLURM_JOB_PARTITION", "SLURM_CPUS_PER_TASK", "SLURM_MEM_PER_NODE", "SLURM_GPUS", "SLURMD_NODENAME", "SLURM_JOB_NAME", "SLURM_ARRAY_JOB_ID", "SLURM_ARRAY_TASK_ID", "PATH", "PWD", "HOME", "LANG", "LC_ALL", "HOSTNAME", "SHELL", "TMPDIR", "USER"]; print("\\n".join(key + "=" + repr(os.environ[key]) for key in sorted(keys) if key in os.environ))' > "\$run_dir/artifacts/environment.txt"
apptainer --version > "\$run_dir/artifacts/container.txt" 2>/dev/null || true

# Match interactive runs: refuse concurrent git operations in this repository.
exec 200>"\$repo/.agentrun.lock"
if ! flock -n 200; then
    printf 'another agentrun is already active on this repo (%s).\n' "\$repo" >&2
    exit 1
fi
set +e
bash "\$run_dir/apptainer_exec.sh" 200>&- 2>>"\$run_dir/live/stderr.log"
rc=\$?
set -e
printf '%s\n' "\$rc" > "\$run_dir/live/exit_code.txt"
if [ "\$rc" -eq 0 ]; then
    printf '{"status":"success","agent":"$agent","mode":"$mode","job_id":"%s"}\n' "\${SLURM_JOB_ID:-}" > "\$run_dir/live/status.json"
else
    printf '{"status":"failed","exit_code":"%s","agent":"$agent","mode":"$mode","job_id":"%s"}\n' "\$rc" "\${SLURM_JOB_ID:-}" > "\$run_dir/live/status.json"
fi
if [ -f "\$run_dir/artifacts/run_title.txt" ]; then
    _title="\$(tr ' ' '-' < "\$run_dir/artifacts/run_title.txt" | tr -cd 'a-zA-Z0-9_-')"
    if [ -n "\$_title" ]; then
        _cleanup_home
        trap - EXIT
        mv "\$run_dir" "\$runs_dir/\${run_base}_\${_title}"
        ln -sfn "\${run_base}_\${_title}" "\$runs_dir/latest"
    fi
fi
exit "\$rc"
EOF
    chmod +x "$run_dir/apptainer_exec.sh" "$run_dir/submit.sbatch"
}

