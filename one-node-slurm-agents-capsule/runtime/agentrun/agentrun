#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
source "$ROOT_DIR/runtime/agentrun/process-cleanup.sh"
DEFAULT_AGENT="claude"
SUPPORTED_AGENTS=(codex claude)
PROFILES="assist experiment campaign review multi-review"

usage() {
    cat <<'USAGE'
Usage:
  agentrun agents
  agentrun sync-claude
  agentrun sync-codex
  agentrun validate
  agentrun doctor [--agent NAME|--all]
  agentrun dry-run MODE [options] PROMPT
  agentrun assist [options] [PROMPT]        # interactive PTY session via srun --pty; PROMPT ignored if given
  agentrun assist --submit [options] PROMPT # batch via sbatch (non-interactive)
  agentrun experiment|campaign|review|multi-review [options] PROMPT  # prepare, or batch with --submit
  agentrun resume [RUN_ID|RUN_DIR] [--time HH:MM:SS] [--mem SIZE] [--cpus N] [--bind SRC:DST[:OPTIONS]]
  agentrun resume --list
  agentrun resume RUN_ID --preview
  agentrun history [RUN_ID|RUN_DIR] [--watch]  # export now, or recover a host-side batch collector
  agentrun wizard [options] [PROMPT]         # guided/menu-driven alternative to assist|experiment|campaign|review|multi-review
  agentrun skill-install SOURCE_DIR|GIT_URL [SKILL_NAME...] [--force]
  agentrun smoke-test [--agent NAME]
  agentrun init-goal
  agentrun status
  agentrun logs [--follow]
  agentrun tail
  agentrun list-runs
  agentrun open-run [RUN_DIR]
  agentrun verify-run [RUN_DIR|--run-id RUN_ID]
  agentrun auth login --agent NAME|--all
  agentrun auth import --agent NAME|--all
  agentrun auth status [--agent NAME]
  agentrun auth reset --agent NAME

Options:
  --agent NAME        codex or claude (default: claude)
  --repo PATH         repository path, default: .
  --goal PATH         goal.yaml path
  --gpus N            GPU count, default: 0
  --mem SIZE          memory (e.g. 16000M), default comes from the selected profile
  --cpus N            CPU core count, default comes from the selected profile
  --time HH:MM:SS     walltime, default comes from the selected profile
  --partition NAME    Slurm partition, default: AGENTRUN_SLURM_PARTITION or cluster default
  --bind SRC:DST[:OPTIONS]  extra bind mount (repeatable); OPTIONS: ro|rw
  --allow-fuse        bind /dev/fuse into the capsule so nested apptainer/FUSE
                      mounts work (default off; AGENTRUN_ALLOW_FUSE=1 to opt in globally)
  --no-allow-fuse     force /dev/fuse off even if AGENTRUN_ALLOW_FUSE=1
  --secrets-file PATH pass KEY=VALUE lines from PATH into the capsule as environment
                      variables (default: secrets/.env if present; AGENTRUN_SECRETS_FILE)
  --no-secrets        do not pass any secrets file
  --no-gh-broker      do not start the GitHub CLI broker even if secrets/gh.env sets GH_TOKEN
  --reviewers LIST    reviewer agents
  --target-diff PATH  review target diff
  --target-report PATH review target report
  --agents LIST       multi-review agents
  --show-mounts       print mount plan in dry-run
  --submit            submit prepared run with sbatch
USAGE
}

is_profile() {
    case " $PROFILES " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

is_supported_agent() {
    local candidate
    for candidate in "${SUPPORTED_AGENTS[@]}"; do
        [ "$1" != "$candidate" ] || return 0
    done
    return 1
}

require_supported_agent() {
    is_supported_agent "$1" || {
        printf 'unknown agent: %s (supported: codex, claude)\n' "$1" >&2
        return 2
    }
}

validate_agent_list() {
    local remaining="$1" agent
    [ -n "$remaining" ] || return 0
    while :; do
        agent="${remaining%%,*}"
        require_supported_agent "$agent" || return $?
        [[ "$remaining" == *,* ]] || break
        remaining="${remaining#*,}"
    done
}

first_available() {
    for cmd in "$@"; do
        if command -v "$cmd" >/dev/null 2>&1; then
            command -v "$cmd"
            return 0
        fi
    done
    return 1
}

# --- wizard UI backend: gum -> whiptail/dialog -> plain read/select ---

detect_wizard_ui() {
    [ -n "${WIZARD_UI:-}" ] && return 0
    if command -v gum >/dev/null 2>&1; then
        WIZARD_UI="gum"
        return 0
    fi
    printf 'gum not found, falling back to whiptail\n' >&2
    if command -v whiptail >/dev/null 2>&1; then
        WIZARD_UI="whiptail"
        DIALOG_BIN="whiptail"
        return 0
    fi
    printf 'whiptail not found, falling back to dialog\n' >&2
    if command -v dialog >/dev/null 2>&1; then
        WIZARD_UI="dialog"
        DIALOG_BIN="dialog"
        return 0
    fi
    printf 'dialog not found, falling back to plain prompts\n' >&2
    WIZARD_UI="plain"
}

source "$ROOT_DIR/runtime/agentrun/wizard.sh"

agent_command() {
    local agent="$1" mode="${2:-}" launch="${3:-batch}"
    case "$agent" in
        claude)
            if [ "$mode" = "assist" ] && [ "$launch" = "interactive" ]; then
                printf 'cd /workspace && claude --dangerously-skip-permissions "$(cat /runs/prompt.txt)"\n'
            else
                printf 'cd /workspace && claude --print --dangerously-skip-permissions "$(cat /runs/prompt.txt)"\n'
            fi
            ;;
        codex)
            if [ "$mode" = "assist" ] && [ "$launch" = "interactive" ]; then
                printf '%s\n' 'cd /workspace && codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --cd /workspace -c '\''sqlite_home="/home/sandbox/.codex/sqlite"'\'' "$(cat /runs/prompt.txt)"'
            else
                printf '%s\n' 'cd /workspace && codex exec --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --skip-git-repo-check --cd /workspace -c '\''sqlite_home="/home/sandbox/.codex/sqlite"'\'' "$(cat /runs/prompt.txt)"'
            fi
            ;;
        *) printf 'unknown agent: %s\n' "$agent" >&2; return 2 ;;
    esac
}

profile_cpus() {
    case "$1" in
        experiment|campaign) printf '8\n' ;;
        *) printf '4\n' ;;
    esac
}

profile_mem() {
    case "$1" in
        experiment|campaign) printf '64000M\n' ;;
        review) printf '16000M\n' ;;
        *) printf '32000M\n' ;;
    esac
}

profile_time() {
    case "$1" in
        experiment) printf '08:00:00\n' ;;
        campaign) printf '08:00:00\n' ;;
        multi-review) printf '02:00:00\n' ;;
        *) printf '01:00:00\n' ;;
    esac
}

profile_required_outputs() {
    case "$1" in
        assist|experiment|campaign|review|multi-review|smoke-test) ;;
        *) return 1 ;;
    esac
    printf '%s\n' \
        live/status.json \
        live/heartbeat.txt \
        live/stdout.log \
        live/stderr.log \
        live/command_log.jsonl \
        live/events.jsonl \
        live/current_task.md \
        artifacts/report.md \
        artifacts/git_diff.patch \
        artifacts/metrics.json \
        artifacts/run_title.txt
    case "$1" in
        experiment)
            printf '%s\n' artifacts/proposed_next.yaml ;;
        campaign)
            printf '%s\n' artifacts/proposed_next.yaml artifacts/proposed_train.sbatch ;;
        review)
            printf '%s\n' reviews/review_findings.json ;;
        multi-review)
            printf '%s\n' \
                reviews/claude.md \
                reviews/codex.md \
                reviews/summary.md \
                reviews/disagreements.json \
                reviews/final_recommendation.md ;;
    esac
}

slurm_partition_args() {
    local partition="${1:-${AGENTRUN_SLURM_PARTITION:-}}"
    [ -n "$partition" ] || return 0
    printf '#SBATCH --partition=%s\n' "$partition"
}

srun_partition_args() {
    local partition="${1:-${AGENTRUN_SLURM_PARTITION:-}}"
    [ -n "$partition" ] || return 0
    printf ' --partition=%s' "$partition"
}

slurm_log_directives() {
    # SBATCH parses its own arguments; do not use Bash's $'...' quoting here.
    local path="$1"
    path="${path//\\/\\\\}"
    path="${path//\"/\\\"}"
    printf '#SBATCH --output="%s/live/slurm.out"\n' "$path"
    printf '#SBATCH --error="%s/live/slurm.err"\n' "$path"
}

run_id() {
    date +"%Y%m%d_%H%M%S_$1_$2"
}

allocate_run_dir() {
    local path="$PWD/.agent-runs/$(run_id "$1" "$2")"
    mkdir -p "$PWD/.agent-runs" || return $?
    # mkdir is atomic: concurrent or same-second launches must never reuse home/logs.
    if mkdir "$path" 2>/dev/null; then
        printf '%s\n' "$path"
    else
        mktemp -d "${path}_XXXXXX"
    fi
}

make_layout() {
    local run_dir="$1"
    mkdir -p \
        "$run_dir/live" \
        "$run_dir/artifacts" \
        "$run_dir/reviews" \
        "$run_dir/workspace" \
        "$run_dir/scratch" \
        "$run_dir/cache" \
        "$run_dir/home/.claude" \
        "$run_dir/home/.codex" \
        "$run_dir/home/.codex/skills" \
        "$run_dir/home/.agents"
    : > "$run_dir/live/stdout.log"
    : > "$run_dir/live/stderr.log"
    : > "$run_dir/live/command_log.jsonl"
    : > "$run_dir/live/events.jsonl"
    : > "$run_dir/live/slurm.out"
    : > "$run_dir/live/slurm.err"
    : > "$run_dir/live/exit_code.txt"
    : > "$run_dir/live/slurm_job_id.txt"
    printf 'initialized\n' > "$run_dir/live/current_task.md"
    printf '{}\n' > "$run_dir/live/status.json"
    date -Iseconds > "$run_dir/live/heartbeat.txt"
    : > "$run_dir/artifacts/git_diff.patch"
    printf '{}\n' > "$run_dir/artifacts/metrics.json"
    : > "$run_dir/artifacts/environment.txt"
    : > "$run_dir/artifacts/container.txt"
    : > "$run_dir/artifacts/data_manifest.txt"
    : > "$run_dir/artifacts/proposed_next.yaml"
    : > "$run_dir/artifacts/proposed_train.sbatch"
    : > "$run_dir/artifacts/run_title.txt"
    : > "$run_dir/reviews/claude.md"
    : > "$run_dir/reviews/codex.md"
    printf '{}\n' > "$run_dir/reviews/review_findings.json"
    : > "$run_dir/reviews/summary.md"
    printf '{}\n' > "$run_dir/reviews/disagreements.json"
    : > "$run_dir/reviews/final_recommendation.md"
    ln -sfn "$(basename "$run_dir")" "$(dirname "$run_dir")/latest"
}

auth_store_root() {
    printf '%s/.agentrun/auth' "$HOME"
}

stage_auth_file() {
    local store_root="$1" agent="$2" rel="$3" run_dir="$4"
    local store_src="$store_root/$agent/$rel"
    local host_src="$HOME/$rel"
    local dst="$run_dir/home/$rel"
    if [ -f "$store_src" ]; then
        cp "$store_src" "$dst"
    elif [ -f "$host_src" ]; then
        cp "$host_src" "$dst"
    fi
}

copy_auth_credentials() {
    local run_dir="$1"
    local store_root
    store_root="$(auth_store_root)"
    # Both providers may be used, but missing peer auth must not prevent work.
    stage_auth_file "$store_root" "claude" ".claude/.credentials.json" "$run_dir"
    stage_auth_file "$store_root" "claude" ".claude.json" "$run_dir"
    stage_auth_file "$store_root" "codex" ".codex/auth.json" "$run_dir"
}

generate_container_config() {
    local run_dir="$1" agent="$2" mode="$3"
    local config_dir="$run_dir/container_config"
    mkdir -p "$config_dir"
    if [ "$agent" = "claude" ]; then
        local base="$ROOT_DIR/agents/claude/settings.json"
        local overlay=""
        if [ "$mode" = "assist" ] && [ -f "$ROOT_DIR/agents/claude/settings.assist.json" ]; then
            overlay="$ROOT_DIR/agents/claude/settings.assist.json"
        elif [ "$mode" = "experiment" ] && [ -f "$ROOT_DIR/agents/claude/settings.experiment.json" ]; then
            overlay="$ROOT_DIR/agents/claude/settings.experiment.json"
        fi
        if [ -n "$overlay" ] && command -v jq >/dev/null 2>&1; then
            # Deep-merge base + overlay; concatenate permission arrays so hooks are preserved.
            jq -s '
              .[0] as $b | .[1] as $o |
              ($b + $o + {
                permissions: {
                  allow: (($b.permissions.allow // []) + ($o.permissions.allow // [])),
                  deny:  (($b.permissions.deny  // []) + ($o.permissions.deny  // [])),
                  ask:   (($b.permissions.ask   // []) + ($o.permissions.ask   // []))
                }
              }) | del(.extends)
            ' "$base" "$overlay" > "$config_dir/settings.json"
        else
            cp "$base" "$config_dir/settings.json"
        fi
    elif [ "$agent" = "codex" ]; then
        cp "$(codex_config_source "$mode")" "$config_dir/config.toml"
    fi
    python3 - "$config_dir" "$agent" <<'PY'
import json
from pathlib import Path
import sys
directory, agent = Path(sys.argv[1]), sys.argv[2]
server = {"command": "/opt/agentrun/agent-review", "args": ["mcp"]}
(directory / "review-mcp.json").write_text(json.dumps({"mcpServers": {"cross-review": server}}) + "\n")
if agent == "codex":
    with (directory / "config.toml").open("a") as stream:
        stream.write('\n[mcp_servers.cross-review]\ncommand = "/opt/agentrun/agent-review"\nargs = ["mcp"]\nstartup_timeout_sec = 120\ntool_timeout_sec = 30\n')
PY
}

codex_config_source() {
    local mode="${1:-}"
    if [ "$mode" = "assist" ] && [ -f "$ROOT_DIR/agents/codex/config.assist.toml" ]; then
        printf '%s\n' "$ROOT_DIR/agents/codex/config.assist.toml"
    elif [ "$mode" = "experiment" ] && [ -f "$ROOT_DIR/agents/codex/config.experiment.toml" ]; then
        printf '%s\n' "$ROOT_DIR/agents/codex/config.experiment.toml"
    else
        printf '%s\n' "$ROOT_DIR/agents/codex/config.toml"
    fi
}

link_codex_shared_assets() {
    local run_dir="$1"
    local skill skill_name
    mkdir -p "$run_dir/home/.codex/skills"
    cp "$run_dir/container_config/config.toml" "$run_dir/home/.codex/config.toml"
    for skill in "$ROOT_DIR"/common/skills/*; do
        [ -d "$skill" ] || continue
        skill_name="$(basename "$skill")"
        ln -sfn "$CONTAINER_CONFIG_DIR/common/skills/$skill_name" \
            "$run_dir/home/.codex/skills/$skill_name"
    done
}

home_config_mounts() {
    local agent="$1" run_dir="${2:-}" mode="${3:-}"
    case "$agent" in
        claude)
            local settings="$ROOT_DIR/agents/claude/settings.json"
            if [ -n "$run_dir" ] && [ -f "$run_dir/container_config/settings.json" ]; then
                settings="$run_dir/container_config/settings.json"
            fi
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/claude/CLAUDE.md" "/home/sandbox/.claude/CLAUDE.md"
            printf ' --bind %q:%q:ro' "$settings" "/home/sandbox/.claude/settings.json"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/common/hooks" "/home/sandbox/.claude/hooks"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/claude/skills" "/home/sandbox/.claude/skills"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/claude/statusline.sh" "/home/sandbox/.claude/statusline.sh"
            ;;
        codex)
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/codex/requirements.toml" "/etc/codex/requirements.toml"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/codex/AGENTS.md" "/home/sandbox/.codex/AGENTS.md"
            printf ' --bind %q:%q:ro' "$ROOT_DIR/agents/codex/rules" "/home/sandbox/.codex/rules"
            ;;
    esac
}

write_prompt() {
    local path="$1" mode="$2" agent="$3" repo="$4" prompt="$5" launch="${6:-batch}" \
        mem="${7:-}" cpus="${8:-}" gpus="${9:-}" time_limit="${10:-}" partition="${11:-}"
    local resources="mem=$mem, cpus=$cpus, time=$time_limit, gpus=$gpus, partition=${partition:-<cluster default>}"

    if [ "$mode" = "assist" ] && [ "$launch" = "interactive" ]; then
        cat > "$path" <<EOF
You are running inside an HPC agent capsule.

Mode: $mode
Agent: $agent
Workspace: /workspace
Runs: /runs
Scratch: /scratch
Resources: $resources
Host repo: $repo

Wait for the user's first instruction. Do not read files, explore the repository, or run any commands until the user tells you what to do.
EOF
        append_gh_broker_note "$path"
        return 0
    fi

    local prefix=""
    if [ "$mode" = "experiment" ] || [ "$mode" = "campaign" ]; then
        prefix="/goal "
    fi

    cat > "$path" <<EOF
${prefix}You are running inside an HPC agent capsule.

Mode: $mode
Agent: $agent
Workspace: /workspace
Runs: /runs
Scratch: /scratch
Resources: $resources

User goal:
$prompt

Required outputs (paths are inside the capsule):
$(profile_required_outputs "$mode" | sed 's|^|- /runs/|')

Run title: At the very end, write a ~5-word summary of what you accomplished (single line, lowercase, e.g. "trained cifar baseline model") to /runs/artifacts/run_title.txt.

Host repo: $repo
EOF
    if [ -n "${GOAL:-}" ]; then
        printf '\nGoal file: /runs/goal.yaml\n' >> "$path"
    fi
    if [ -n "${REVIEWERS:-}" ]; then
        printf '\nReviewers: %s\n' "$REVIEWERS" >> "$path"
    fi
    if [ -n "${TARGET_DIFF:-}" ]; then
        printf '\nTarget diff: %s\n' "$TARGET_DIFF" >> "$path"
    fi
    if [ -n "${TARGET_REPORT:-}" ]; then
        printf '\nTarget report: %s\n' "$TARGET_REPORT" >> "$path"
    fi
    if [ -n "${REQUESTED_AGENTS:-}" ]; then
        printf '\nRequested agents: %s\n' "$REQUESTED_AGENTS" >> "$path"
    fi
    append_gh_broker_note "$path"
}

append_gh_broker_note() {
    gh_broker_enabled || return 0
    local allowed
    allowed="$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' -e 's/[[:space:]]*$//' "$GH_BROKER_SRC/allowlist.txt" | sed 's/^/- gh /')"
    cat >> "$1" <<EOF

GitHub CLI: \`gh\` works through a broker; no GitHub credentials exist in this capsule, so do not look for them.
Only these commands, with only the listed long flags (\`--flag value\`), are accepted:
$allowed
Pass issue/PR numbers explicitly (no URLs), and use --body-file FILE (or --body-file -) for bodies. \`gh api\` is not available; read issue comments with \`gh issue view <number> --json comments\`.
EOF
}

# `--containall` gives the capsule a minimal /dev, so /dev/fuse is absent even
# when the host exposes it. Without it a nested `apptainer exec` cannot mount the
# inner .sif (squashfuse_ll fails) — bind it back in when the run opts in.
FUSE_DEVICE="/dev/fuse"

fuse_enabled() {
    [ "${ALLOW_FUSE:-0}" -eq 1 ]
}

fuse_bind_spec() {
    printf '%s:%s:rw\n' "$FUSE_DEVICE" "$FUSE_DEVICE"
}

# Only the pieces the capsule actually needs from this repository are bound in,
# never the whole of ROOT_DIR, so anything else kept here (e.g. secrets files)
# stays invisible to the agent. Codex's /etc/codex/requirements.toml and its
# ~/.codex/skills symlinks point at these exact container paths.
CONTAINER_CONFIG_DIR="/home/sandbox/ai-agent-config"
SHARED_CONFIG_SUBDIRS="common/hooks common/skills"

shared_config_bind_specs() {
    local sub
    for sub in $SHARED_CONFIG_SUBDIRS; do
        printf '%s:%s:ro\n' "$ROOT_DIR/$sub" "$CONTAINER_CONFIG_DIR/$sub"
    done
}

# Secrets reach the capsule only through `apptainer exec --env-file`: the file is
# read by apptainer on the compute node and is never bound into the container, and
# no value is ever written to the run directory (which the agent sees as /runs).
# Only the path and the variable names appear in generated files. Values still
# end up in the agent's environment, so they must be treated as readable by it.
DEFAULT_SECRETS_FILE="$ROOT_DIR/secrets/.env"
SECRETS_TEMPLATE="$ROOT_DIR/secrets/.env.example"

secrets_enabled() {
    [ -n "${SECRETS_FILE:-}" ]
}

# Names of the variables actually assigned (non-empty) in a secrets file.
secret_keys() {
    local file="$1"
    [ -r "$file" ] || return 0
    sed -nE 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=[[:space:]]*[^[:space:]#].*$/\2/p' "$file"
}

secret_keys_csv() {
    secret_keys "$1" | paste -sd, -
}

secrets_file_mode_ok() {
    local mode
    mode="$(stat -c '%a' "$1" 2>/dev/null)" || return 1
    [ "${mode: -2}" = "00" ]
}

# Create the default secrets file from the committed template, owner-only.
ensure_default_secrets_file() {
    [ -e "$DEFAULT_SECRETS_FILE" ] && return 0
    [ -f "$SECRETS_TEMPLATE" ] || return 0
    (umask 077 && cp "$SECRETS_TEMPLATE" "$DEFAULT_SECRETS_FILE")
    printf 'created %s from template (all entries commented out)\n' "$DEFAULT_SECRETS_FILE" >&2
}

path_is_within() {
    local path="$1" dir="$2"
    [ -n "$dir" ] || return 1
    dir="$(cd "$dir" 2>/dev/null && pwd -P)" || return 1
    case "$path" in
        "$dir"|"$dir"/*) return 0 ;;
        *) return 1 ;;
    esac
}

# GitHub CLI broker: GH_TOKEN from secrets/gh.env is given only to a separate
# apptainer container running runtime/gh-broker/gh_broker.py. The agent's capsule
# gets `gh` replaced by gh-client, which forwards allowlisted commands over a
# Unix socket; neither the token file nor the broker process is visible to it.
GH_BROKER_SRC="$ROOT_DIR/runtime/gh-broker"
DEFAULT_GH_ENV_FILE="$ROOT_DIR/secrets/gh.env"
GH_ENV_TEMPLATE="$ROOT_DIR/secrets/gh.env.example"
GH_BROKER_CONTAINER_DIR="/opt/gh-broker"

gh_broker_enabled() {
    [ -n "${GH_ENV_FILE:-}" ]
}

file_sets_key() {
    local file="$1" key="$2"
    secret_keys "$file" | grep -qx "$key"
}

# Printed into apptainer_exec.sh before the agent's apptainer exec. The socket
# directory lives in the node's /tmp (not the run directory) and is removed on exit.
gh_broker_launch_lines() {
    local run_dir="$1" image="$2"
    cat <<EOF
GH_BROKER_DIR="\$(mktemp -d /tmp/agentrun-gh.XXXXXX)"
_cleanup_gh_broker() {
    local rc=\$?
    trap - EXIT
    trap '' HUP INT TERM
    if [ -n "\${GH_BROKER_PID:-}" ]; then
        _agentrun_stop_process "\$GH_BROKER_PID" 'GitHub broker process' || true
    fi
    timeout --kill-after=2s 5s rm -rf "\$GH_BROKER_DIR" || true
    exit "\$rc"
}
trap _cleanup_gh_broker EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
apptainer exec --containall --cleanenv --no-mount hostfs,bind-paths,cwd --pwd /tmp --bind /etc/resolv.conf:/etc/resolv.conf:ro --bind /etc/hosts:/etc/hosts:ro --env-file $(printf '%q' "$GH_ENV_FILE") --bind $(printf '%q' "$GH_BROKER_SRC"):$GH_BROKER_CONTAINER_DIR-src:ro --bind "\$GH_BROKER_DIR":$GH_BROKER_CONTAINER_DIR:rw $(printf '%q' "$image") python3 $GH_BROKER_CONTAINER_DIR-src/gh_broker.py $GH_BROKER_CONTAINER_DIR/gh.sock 2>>$(printf '%q' "$run_dir/live/gh_broker.log") &
GH_BROKER_PID=\$!
for _ in \$(seq 150); do
    [ -S "\$GH_BROKER_DIR/gh.sock" ] && break
