command_sync_claude() {
    if [ "$#" -ne 0 ]; then
        printf 'sync-claude takes no arguments\n' >&2
        return 2
    fi
    if ! command -v jq >/dev/null 2>&1; then
        printf 'jq is required for sync-claude\n' >&2
        return 1
    fi
    validate_claude_hook_manifest >/dev/null
    local hooks_tmp settings_tmp
    hooks_tmp="$(mktemp)"
    settings_tmp="$(mktemp)"
    render_claude_settings_hooks "$hooks_tmp"
    jq --slurpfile h "$hooks_tmp" '.hooks = $h[0]' \
        "$ROOT_DIR/agents/claude/settings.json" > "$settings_tmp"
    mv "$settings_tmp" "$ROOT_DIR/agents/claude/settings.json"
    chmod 0644 "$ROOT_DIR/agents/claude/settings.json"
