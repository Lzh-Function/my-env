check_agent_auth() {
    local agent="$1" failed=0
    local store_root
    store_root="$(auth_store_root)/$agent"
    _check_auth_file() {
        local store_path="$1" host_path="$2" label="$3"
        if [ -f "$store_path" ]; then
            printf '[OK] auth:%s - store: %s\n' "$label" "$store_path"
        elif [ -f "$host_path" ]; then
            printf '[OK] auth:%s - host: %s (run: agentrun auth import --agent %s to persist to store)\n' \
                "$label" "$host_path" "$agent"
        else
            printf '[FAIL] auth:%s - not found in store (%s) or host (%s)\n' \
                "$label" "$store_path" "$host_path"
            failed=1
        fi
    }
    case "$agent" in
        claude)
            _check_auth_file \
                "$store_root/.claude/.credentials.json" \
                "$HOME/.claude/.credentials.json" \
                "claude:.claude/.credentials.json"
            _check_auth_file \
                "$store_root/.claude.json" \
                "$HOME/.claude.json" \
                "claude:.claude.json"
            ;;
        codex)
            _check_auth_file \
                "$store_root/.codex/auth.json" \
                "$HOME/.codex/auth.json" \
                "codex:.codex/auth.json"
            ;;
        *)
            printf '[FAIL] auth:%s - unknown agent\n' "$agent"
            failed=1
            ;;
    esac
    unset -f _check_auth_file
    return "$failed"
}

codex_hooks_manifest() {
    printf '%s\n' "$ROOT_DIR/agents/codex/hooks.manifest.json"
}

render_codex_requirements_toml() {
    local output="$1"
    local prefix="$CONTAINER_CONFIG_DIR/common/hooks/"
    local manifest
    manifest="$(codex_hooks_manifest)"
    {
        printf '[features]\nhooks = true\n\n[hooks]\nmanaged_dir = "%s"\n\n' "${prefix%/}"
        jq -rj --arg prefix "$prefix" '
            .hooks[] |
            . as $g |
            .event as $e |
            (
                "[[hooks." + $e + "]]\n" +
                (if (($g.matcher // "") != "") then "matcher = \"" + $g.matcher + "\"\n" else "" end) +
                "\n",
                (
                    $g.entries[] |
                    "[[hooks." + $e + ".hooks]]\ntype = \"command\"\ncommand = " +
                    (($prefix + "worker_hook.py " + $prefix + .script) | @json) +
                    "\ntimeout = 30\n\n"
                )
            )
        ' "$manifest"
    } > "$output"
}

validate_codex_hook_manifest() {
    local manifest hook failed=0 event
    manifest="$(codex_hooks_manifest)"
    if [ ! -f "$manifest" ]; then
        printf '[FAIL] agents/codex/hooks.manifest.json\n'
        return 1
    fi
    if ! jq -e '
      type == "object" and
      ((.hooks // []) | type == "array" and all(.[];
        type == "object" and
        (.event | type == "string" and length > 0) and
        (.matcher | type == "string" or type == "null") and
        (.entries | type == "array" and all(.[]; type == "object" and (.script | type == "string" and length > 0)))
      )) and
      ((.ignored // []) | type == "array" and all(.[]; type == "string"))
    ' "$manifest" >/dev/null; then
        printf '[FAIL] codex-hooks-manifest:shape\n'
        return 1
    fi
    while IFS=$'\t' read -r event hook; do
        [ -n "$hook" ] || continue
        case "$hook" in
            ""|*/*|*..*|*[!A-Za-z0-9_.-]*)
                printf '[FAIL] codex-hooks-manifest:invalid-name:%s\n' "$hook"
                failed=1
                continue
                ;;
        esac
        if [ -x "$ROOT_DIR/common/hooks/$hook" ]; then
            printf '[OK] codex-hooks-manifest:%s:%s\n' "$event" "$hook"
        else
            printf '[FAIL] codex-hooks-manifest:%s:%s\n' "$event" "$hook"
            failed=1
        fi
    done < <(jq -r '.hooks[] | .event as $e | .entries[].script | [$e, .] | @tsv' "$manifest")
    while IFS= read -r hook; do
        [ -n "$hook" ] || continue
        case "$hook" in
            ""|*/*|*..*|*[!A-Za-z0-9_.-]*)
                printf '[FAIL] codex-hooks-manifest:invalid-ignored-name:%s\n' "$hook"
                failed=1
                continue
                ;;
        esac
        if [ -e "$ROOT_DIR/common/hooks/$hook" ]; then
            printf '[OK] codex-hooks-ignored:%s\n' "$hook"
        else
            printf '[FAIL] codex-hooks-ignored:%s\n' "$hook"
            failed=1
        fi
    done < <(jq -r '(.ignored // [])[]' "$manifest")
    local covered
    local unclassified=0
    covered="$(jq -r '.hooks[].entries[].script, (.ignored // [])[]' "$manifest")"
    for hook_path in "$ROOT_DIR"/common/hooks/*.py; do
        [ -e "$hook_path" ] || continue
        hook="$(basename "$hook_path")"
        if printf '%s\n' "$covered" | grep -Fxq "$hook"; then
            :
        else
            printf '[FAIL] codex-hooks-unclassified:%s - add to hooks or ignored\n' "$hook"
            unclassified=1
            failed=1
        fi
    done
    if [ "$unclassified" -eq 0 ]; then
        printf '[OK] codex-hooks-classified:all-common-hooks\n'
    fi
    return "$failed"
}

command_sync_codex() {
    if [ "$#" -ne 0 ]; then
        printf 'sync-codex takes no arguments\n' >&2
        return 2
    fi
    if ! command -v jq >/dev/null 2>&1; then
        printf 'jq is required for sync-codex\n' >&2
        return 1
    fi
    validate_codex_hook_manifest >/dev/null
    local tmp
    tmp="$(mktemp)"
    render_codex_requirements_toml "$tmp"
    mv "$tmp" "$ROOT_DIR/agents/codex/requirements.toml"
    chmod 0644 "$ROOT_DIR/agents/codex/requirements.toml"
    ln -sfnT ../../common/AGENTS.md "$ROOT_DIR/agents/codex/AGENTS.md"
    ln -sfnT ../../common/skills "$ROOT_DIR/agents/codex/skills"
    printf '[OK] synced agents/codex/requirements.toml from agents/codex/hooks.manifest.json\n'
    printf '[OK] synced agents/codex/AGENTS.md -> ../../common/AGENTS.md\n'
    printf '[OK] synced agents/codex/skills -> ../../common/skills\n'
}

